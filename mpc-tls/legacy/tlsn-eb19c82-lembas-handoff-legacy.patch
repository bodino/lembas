+    /// Queues the hidden header record: `plaintext` is the full header text,
+    /// of which the follower learns nothing but the length, and `token` is
+    /// the span the leader fills in. The rest of the text must match the
+    /// follower's template, which is what actually gets encrypted.
+    ///
+    /// Call [`process_new_packets`](Self::process_new_packets) afterwards to
+    /// encrypt it and queue it for [`write_tls`](CommonState::write_tls).
+    pub async fn write_hidden(
+        &mut self,
+        plaintext: &[u8],
+        token: std::ops::Range<usize>,
+    ) -> Result<(), Error> {
+        if !self.common_state.may_send_application_data {
+            return Err(Error::HandshakeNotComplete);
+        }
+
+        if plaintext.len() > crate::handoff::MAX_RECORD_PLAINTEXT {
+            return Err(crate::MpcTlsError::record_layer(
+                "hidden record exceeds the maximum record size",
+            )
+            .into());
+        }
+
+        self.common_state
+            .backend
+            .push_outgoing_hidden(
+                PlainMessage {
+                    typ: ContentType::ApplicationData,
+                    version: ProtocolVersion::TLSv1_2,
+                    payload: Payload::new(plaintext),
+                },
+                token,
+            )
+            .await?;
+
+        Ok(())
+    }
