+//! One-time-pad masks whose pad is allocated before preprocessing.
+//!
+//! mpz's `mask_private` and `mask_blind` allocate the pad at the point of use.
+//! When the pad's owner is the garbled-circuit evaluator, that is a private
+//! input for which no oblivious transfers were preprocessed, and the protocol
+//! stalls. Allocating the pad up front, as part of the session, makes it an
+//! ordinary preprocessed input.
+
+use std::sync::Arc;
+
+use mpz_circuits::circuits::xor;
+use mpz_memory_core::{Repr, binary::Binary};
+use mpz_vm_core::{Call, Vm, prelude::*};
+
+use crate::MpcTlsError;
+
+/// A mask allocated ahead of time and applied once.
+pub(crate) struct PreparedMask<R> {
+    pad: R,
+    /// Whether this party supplies the pad.
+    owner: bool,
+    used: bool,
+}
+
+impl<R> PreparedMask<R>
+where
+    R: Repr<Binary> + Copy,
+{
+    /// Takes ownership of an allocated, unmarked `pad` and marks it private
+    /// for the owner and blind for the other party.
+    pub(crate) fn new(vm: &mut dyn Vm<Binary>, pad: R, owner: bool) -> Result<Self, MpcTlsError> {
+        if owner {
+            vm.mark_private(pad).map_err(MpcTlsError::record_layer)?;
+        } else {
+            vm.mark_blind(pad).map_err(MpcTlsError::record_layer)?;
+        }
+
+        Ok(Self {
+            pad,
+            owner,
+            used: false,
+        })
+    }
+
+    /// Returns the pad reference, for taking a part of it.
+    pub(crate) fn pad(&self) -> R {
+        self.pad
+    }
+
+    /// Masks `value` with `pad_ref`, which must be the pad or a part of it, of
+    /// the same size as `value`. The owner passes the pad's value.
+    pub(crate) fn apply(
+        &mut self,
+        vm: &mut dyn Vm<Binary>,
+        value: R,
+        pad_ref: R,
+        pad: Option<R::Clear>,
+    ) -> Result<R, MpcTlsError> {
+        if self.used {
+            return Err(MpcTlsError::record_layer("mask was already used"));
+        }
+        self.used = true;
+
+        let size = value.to_raw().len();
+        if pad_ref.to_raw().len() != size {
+            return Err(MpcTlsError::record_layer("mask size does not match value"));
+        }
+
+        match (self.owner, pad) {
+            (true, Some(pad)) => vm.assign(pad_ref, pad).map_err(MpcTlsError::record_layer)?,
+            (true, None) => return Err(MpcTlsError::record_layer("mask owner must supply the pad")),
+            (false, Some(_)) => {
+                return Err(MpcTlsError::record_layer(
+                    "only the mask owner supplies the pad",
+                ));
+            }
+            (false, None) => {}
+        }
+        vm.commit(pad_ref).map_err(MpcTlsError::record_layer)?;
+
+        vm.call(
+            Call::builder(Arc::new(xor(size)))
+                .arg(value)
+                .arg(pad_ref)
+                .build()
+                .map_err(MpcTlsError::record_layer)?,
+        )
+        .map_err(MpcTlsError::record_layer)
+    }
+}
