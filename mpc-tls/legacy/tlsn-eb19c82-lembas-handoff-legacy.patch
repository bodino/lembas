+    /// [`read_tls`](Self::read_tls) and [`write_tls`](CommonState::write_tls)
+    /// to relay records between the server and the follower.
+    pub async fn handoff(&mut self) -> Result<(), Error> {
+        if self.common_state.is_handshaking() {
+            return Err(Error::HandshakeNotComplete);
+        }
+
+        self.common_state.backend.handoff().await?;
+
+        Ok(())
+    }
+
+    /// Takes the leader's relay after [`handoff`](Self::handoff).
+    pub fn take_relay(&mut self) -> Option<crate::LeaderRelay> {
