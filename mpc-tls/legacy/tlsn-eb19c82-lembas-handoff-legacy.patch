index 0000000..0810ab3
--- /dev/null
+++ b/crates/lembas-mpc/src/lib.rs
@@ -0,0 +1,1011 @@
+//! Borrowed requests over MPC-TLS.
+//!
+//! Two parties act as one TLS client towards the API server:
+//!
+//! * the **pool** (MPC-TLS leader) holds the TCP connection and the token,
+//!   which it puts in the `Authorization` header;
+//! * the **borrower** (MPC-TLS follower) writes the request and reads the
+//!   response.
+//!
+//! The handshake runs in MPC, with the borrower verifying the server's
+//! certificate itself. For the header record only keystream is computed
+//! jointly: the token span's keystream goes to the pool alone, which applies
+//! its token locally, and the tag binds the pool to the borrower's text
+//! everywhere else. Then the pool hands both traffic keys to the borrower,
+//! which encrypts the body and decrypts the response itself while the pool
+//! only relays records it cannot read or alter. The pool does see the
+//! borrower's header template (path, user agent, betas): everything in the
+//! request but the token is the borrower's, and everything in it but the
+//! header is hidden from the pool.
+//!
+//! The link between pool and borrower must itself be authenticated (in
+//! lembas, the existing pool WebSocket over TLS). A man in the middle on it
+//! can only cause failures, never read or forge, but the pool must know it is
+//! lending to a member.
+//!
+//! The pool and the borrower talk over one byte stream multiplexed by
+//! tlsn-mux. Each side opens two channels in the same order: the first carries
+//! the MPC protocol and then the borrower's records, the second a short
+//! prelude and then the server's records back to the borrower.
+
+use std::{
+    future::Future,
+    ops::Range,
+    pin::Pin,
+    sync::Arc,
+    time::{Duration, Instant},
+};
+
+use anyhow::{Context as _, Result, bail, ensure};
+use mpc_tls::{
+    Config, HeaderTemplate, MpcTlsFollower, MpcTlsLeader, RelayCommand, RelayEvent, TrafficKeys,
+    client::{ClientConfig, ClientConnection, RootCertStore, ServerName},
+};
+use mpz_common::{Context, Session, ThreadPool, ThreadPoolBuildError, mux::Mux};
+use mpz_core::Block;
+use mpz_garble::protocol::semihonest::{Evaluator, Garbler};
+use mpz_garble_core::Delta;
+use mpz_ot::{
+    chou_orlandi as co,
+    cot::{DerandCOTReceiver, DerandCOTSender},
+    kos,
+    rcot::shared::{SharedRCOTReceiver, SharedRCOTSender},
+};
+use rand::RngExt;
+use rustls_pki_types::CertificateDer;
+use serde::{Deserialize, Serialize};
+use serio::{SinkExt, stream::IoStreamExt};
+use tls_core::msgs::enums::{AlertDescription, AlertLevel, ContentType};
+use tokio::{
+    io::{AsyncRead, AsyncReadExt, AsyncWrite, AsyncWriteExt},
+    sync::Mutex,
+};
+use tracing::{debug, info};
+use webpki::anchor_from_trusted_cert;
+
+pub mod splice;
+
+/// Largest header record the pool may send.
+/// Only the part of the header up to and including the Authorization line is
+/// encrypted jointly (the request line, Host, Content-Length, the bearer line:
+/// about 230 bytes); the rest of the headers follow in a record the borrower
+/// encrypts alone. Each 16-byte block costs ~180 KB of garbled circuit, so
+/// this budget is kept tight.
+pub const MAX_HEADER_LEN: usize = 320;
+
+/// Marker in a borrower's template that becomes the token span.
+pub const TOKEN_MARKER: &str = "{token}";
+/// Marker in a borrower's template that becomes the body length.
+pub const BODY_LEN_MARKER: &str = "{body_len}";
+
+/// How long the prelude, preprocessing, handshake and hand-off may take.
+/// The relay itself is unbounded: a model may stream for minutes.
+pub const SETUP_TIMEOUT: Duration = Duration::from_secs(90);
+/// How long the relay waits for the next record from either side before it
+/// gives up. Long enough for a model's thinking pause (the lembas agent's own
+/// request timeout is the same 10 minutes), short enough that a vanished peer
+/// does not hold the pool's helper forever.
+pub const RELAY_IDLE_TIMEOUT: Duration = Duration::from_secs(600);
+/// The most a single borrow may last, idle or not.
+pub const RELAY_MAX_DURATION: Duration = Duration::from_secs(3600);
+/// Largest body a template may announce in `Content-Length`. The pool cannot
+/// read the body, so the announced length and the bytes actually relayed are
+/// its only levers against a borrower spending a lender's quota on huge
+/// requests.
+pub const MAX_BODY_LEN: usize = 64 << 20;
+/// Most bytes the pool relays from the borrower to the server in one borrow:
+/// the announced body plus record framing, with room to spare.
+pub const MAX_SENT_BYTES: usize = MAX_BODY_LEN + (4 << 20);
+/// Records from the borrower waiting to be written to a slow server; beyond
+/// this the pool stops reading until the server catches up.
+pub const MAX_PENDING_BYTES: usize = 4 << 20;
+/// Changes whenever `Hello` or what follows it changes; the wire codec is not
+/// self-describing, so this is what turns an old peer into a clean error.
+pub const PROTOCOL_VERSION: u32 = 3;
+
+/// Protocol settings both sides must share. The pool announces them.
+///
+/// The garbling orientation is deliberately not a setting: the borrower
+/// always garbles (see [`mpc_parts`]). A pool that could choose to garble
+/// could garble a leaking circuit and read the borrower's key pads, so a
+/// message the pool controls must never decide that role.
+#[derive(Debug, Clone, Copy, Serialize, Deserialize)]
+pub struct Settings {
+    /// tlsn's reduced-bandwidth PRF mode. A bandwidth/latency trade-off
+    /// only; both variants compute the same PRF.
+    pub low_bandwidth: bool,
+}
+
+/// The pool's opening message.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct Hello {
+    /// [`PROTOCOL_VERSION`]; the borrower refuses any other.
+    pub version: u32,
+    /// Length of the token the pool will put in the span.
+    pub token_len: usize,
+    /// Server the pool connects to; the borrower's `Host` must match.
+    pub server_name: String,
+    /// Settings for this connection.
+    pub settings: Settings,
+}
+
+/// The borrower's request header.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct RequestHeader {
+    /// Header text, including the final blank line, with any bytes in `token`.
+    pub template: Vec<u8>,
+    /// Span the pool fills with the token.
+    pub token: Range<usize>,
+}
+
+/// Length of a subscription token (`sk-ant-oat01-…`) or API key
+/// (`sk-ant-api03-…`); both are 108 bytes.
+///
+/// This is a security invariant, not a convenience: the token span is
+/// `TOKEN_LEN` rounded up to 16-byte blocks, and the slack a pool has for
+/// smuggling bytes into the span is `span - token`. With a 108-byte token
+/// that is 4 bytes, too few for a header. A shorter credential in the same
+/// span would leave room: 112 - 97 = 15 bytes fit `\r\nX: value`. So the
+/// pool refuses to lend any credential of another length, and the borrower
+/// refuses a pool announcing another length.
+pub const TOKEN_LEN: usize = 108;
+
+/// Rounds a span length up to whole 16-byte blocks.
+fn span_len_for(token_len: usize) -> usize {
+    token_len.div_ceil(16) * 16
+}
+
+/// Checks a borrower's template on the pool's side.
+///
+/// The span must be exactly the value of an `Authorization: Bearer` header,
+/// so the token can only ever land where a bearer token belongs, never in a
+/// path or a header the server might echo. It must be block aligned and no
+/// more than 15 bytes longer than the token, which with a working token
+/// leaves the pool no room for anything else (see `fill_template`). `Host`
+/// must name the server the pool connects to.
+pub fn check_template(header: &RequestHeader, token_len: usize, server_name: &str) -> Result<()> {
+    ensure!(
+        token_len == TOKEN_LEN,
+        "only {TOKEN_LEN}-byte credentials can be lent, see TOKEN_LEN"
+    );
+    let text = &header.template;
+    ensure!(
+        text.len() <= MAX_HEADER_LEN,
+        "header is {} bytes; at most {MAX_HEADER_LEN} can be sent",
+        text.len()
+    );
+    ensure!(
+        text.ends_with(b"\r\n") && !text.ends_with(b"\r\n\r\n"),
+        "the hidden record ends with the Authorization line, not the blank line"
+    );
+    let span = header.token.clone();
+    ensure!(
+        span.start < span.end && span.end <= text.len(),
+        "token span must be inside the header"
+    );
+    ensure!(
+        span.len() == span_len_for(token_len) && span.start.is_multiple_of(16),
+        "token span must be the token length rounded up to 16-byte blocks, block aligned"
+    );
+    ensure!(
+        span.end + 2 == text.len(),
+        "the Authorization line must be the last line of the hidden record"
+    );
+    let head = std::str::from_utf8(&text[..text.len() - 2]).context("header is not UTF-8")?;
+    ensure!(!head.contains("\r\n\r\n"), "header contains a blank line");
+
+    let mut pos = 0;
+    let mut saw_auth = false;
+    let mut saw_host = false;
+    let mut saw_length = false;
+    let mut names = std::collections::HashSet::new();
+    for (i, line) in head.split("\r\n").enumerate() {
+        let line_range = pos..pos + line.len();
+        pos += line.len() + 2;
+        if i == 0 {
+            ensure!(line.ends_with(" HTTP/1.1"), "first line must be an HTTP/1.1 request line");
+            ensure!(line.matches(' ').count() == 2, "malformed request line");
+            continue;
+        }
+        let (name, value) = line.split_once(':').context("malformed header line")?;
+        let name = name.trim().to_ascii_lowercase();
+        ensure!(names.insert(name.clone()), "header {name} appears twice");
+        let value = value.trim_start();
+        let value_start = line_range.start + (line.len() - value.len());
+        if name == "authorization" {
+            ensure!(!saw_auth, "more than one Authorization header");
+            saw_auth = true;
+            let rest = value
+                .strip_prefix("Bearer")
+                .context("Authorization must be a bearer token")?;
+            let spaces = rest.len() - rest.trim_start_matches(' ').len();
+            ensure!(spaces >= 1, "Authorization must be a bearer token");
+            let expected = value_start + "Bearer".len() + spaces..line_range.end;
+            ensure!(
+                span == expected,
+                "token span must be exactly the bearer token value"
+            );
+        } else {
+            ensure!(
+                span.start >= line_range.end || span.end <= line_range.start,
+                "token span overlaps a header other than Authorization"
+            );
+            if name == "host" {
+                ensure!(!saw_host, "more than one Host header");
+                ensure!(value.trim_end() == server_name, "Host must be {server_name}");
+                saw_host = true;
+            }
+            if name == "content-length" {
+                let len: usize = value.trim_end().parse().context("Content-Length is not a number")?;
+                ensure!(len <= MAX_BODY_LEN, "Content-Length {len} is over the {MAX_BODY_LEN}-byte limit");
+                saw_length = true;
+            }
+        }
+    }
+    ensure!(saw_auth, "no Authorization header");
+    ensure!(saw_host, "no Host header");
+    ensure!(saw_length, "no Content-Length header");
+    Ok(())
+}
+
+/// Builds the borrower's header from a template with markers.
+///
+/// The token span is pinned to `token_len` rounded up to whole 16-byte blocks
+/// and aligned to a block boundary by padding the end of the preceding header
+/// line with spaces (optional whitespace, which servers strip). The pool fills
+/// the span with its token followed by spaces. A pool that put anything but a
+/// token in the span would break its own credential, and the alignment leaves
+/// it no byte outside the span, so it cannot smuggle in a header.
+/// Splits a full header template (ending in a blank line) at the line that
+/// carries the token: the first part becomes the hidden record, the rest
+/// (remaining headers plus the blank line) is sent by the borrower alone,
+/// ahead of the body. Fewer bytes in the hidden record means fewer AES blocks
+/// in MPC, so callers put Authorization right after Host and Content-Length.
+pub fn split_template(template: &str) -> Result<(String, Vec<u8>)> {
+    ensure!(
+        template.ends_with("\r\n\r\n"),
+        "template must end with a blank line"
+    );
+    let marker = template
+        .find(TOKEN_MARKER)
+        .context("template has no {token}")?;
+    let line_end = template[marker..]
+        .find("\r\n")
+        .map(|i| marker + i + 2)
+        .unwrap();
+    let (hidden, rest) = template.split_at(line_end);
+    Ok((hidden.to_string(), rest.as_bytes().to_vec()))
+}
+
+pub fn fill_template(template: &str, token_len: usize, body_len: usize) -> Result<RequestHeader> {
+    ensure!(
+        template.matches(TOKEN_MARKER).count() == 1,
+        "template must contain {TOKEN_MARKER} exactly once"
+    );
+    let span_len = span_len_for(token_len);
+    let mut text = template.replace(BODY_LEN_MARKER, &body_len.to_string());
+    let marker = text.find(TOKEN_MARKER).unwrap();
+    let line_start = text[..marker]
+        .rfind("\r\n")
+        .context("the Authorization header must not be the first line")?;
+    ensure!(
+        text[..line_start].contains("\r\n"),
+        "put at least one header before Authorization: the line before it is padded for alignment"
+    );
+    let pad = (16 - marker % 16) % 16;
+    text.insert_str(line_start, &" ".repeat(pad));
+    let start = marker + pad;
+    text.replace_range(start..start + TOKEN_MARKER.len(), &"x".repeat(span_len));
+    // The hidden record ends with the Authorization line; the blank line
+    // comes later, in the borrower's own record (see `split_template`).
+    let mut template = text.into_bytes();
+    ensure!(
+        template.ends_with(b"\r\n") && !template.ends_with(b"\r\n\r\n"),
+        "the hidden part must end right after the Authorization line"
+    );
+    while template.ends_with(b"\r\n\r\n") {
+        template.truncate(template.len() - 2);
+    }
+    Ok(RequestHeader {
+        template,
+        token: start..start + span_len,
+    })
+}
+
+// ---------------------------------------------------------------------------
+// Pool (leader)
+
+/// Test hook: a misbehaving pool's change to the header after the token is
+/// in place.
+pub type Tamper = Option<Box<dyn FnOnce(&mut Vec<u8>) + Send>>;
+
+/// What the pool measured.
+pub struct PoolReport {
+    pub preprocess: Duration,
+    pub handshake: Duration,
+    pub handoff: Duration,
+    /// The encoded header record as sent to the server.
+    pub hidden_record: Vec<u8>,
+    /// The header as sent, with the token in place. Never log it.
+    pub headers: Vec<u8>,
+}
+
+// The report holds the token; a `?report` in a log line must not print it.
+impl std::fmt::Debug for PoolReport {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("PoolReport")
+            .field("preprocess", &self.preprocess)
+            .field("handshake", &self.handshake)
+            .field("handoff", &self.handoff)
+            .field("hidden_record_len", &self.hidden_record.len())
+            .field("headers_len", &self.headers.len())
+            .finish()
+    }
+}
+
+/// Runs the pool's side of one borrowed request.
+///
+/// `ctx` and `to_borrower` are the two channels, in order. `server` is the
+/// connection to the API server; `roots` and `server_name` are how the pool
+/// verifies it. `token` goes into the borrower's `Authorization` header.
+/// `tamper` is a test hook that lets a misbehaving pool change the header
+/// after the token is in place.
+#[allow(clippy::too_many_arguments)]
+pub async fn run_pool<S>(
+    ctx: Context,
+    mut to_borrower: Context,
+    mut server: S,
+    roots: RootCertStore,
+    server_name: &str,
+    token: &str,
+    settings: Settings,
+    tamper: Tamper,
+) -> Result<PoolReport>
+where
+    S: AsyncRead + AsyncWrite + Unpin,
+{
+    ensure!(
+        token.len() == TOKEN_LEN,
+        "refusing to lend a {}-byte credential: only {TOKEN_LEN}-byte ones keep the span tight",
+        token.len()
+    );
+    ensure!(
+        !token.bytes().any(|b| b.is_ascii_whitespace() || b.is_ascii_control()),
+        "credential contains whitespace or control characters"
+    );
+
+    // Everything before the relay has a deadline; a stalled peer must not
+    // hold the pool's token forever.
+    let setup = async {
+    // Prelude: announce the settings, then let the borrower compose while we
+    // preprocess.
+    to_borrower
+        .io_mut()
+        .send(Hello {
+            version: PROTOCOL_VERSION,
+            token_len: token.len(),
+            server_name: server_name.to_string(),
+            settings,
+        })
+        .await
+        .context("prelude: greeting the borrower")?;
+
+    // The pool evaluates, always: see `mpc_parts`.
+    let (vm, cot_send, cot_recv) = mpc_parts(false);
+    let mut leader = MpcTlsLeader::new(
+        mpc_config(settings.low_bandwidth)?,
+        ctx,
+        vm,
+        (cot_send.clone(), cot_send.clone(), cot_send),
+        cot_recv,
+    );
+
+    let t = Instant::now();
+    leader.alloc()?;
+    leader.preprocess().await?;
+    let preprocess = t.elapsed();
+    info!(?preprocess, "pool: preprocessed");
+
+    let request: RequestHeader = to_borrower
+        .io_mut()
+        .expect_next()
+        .await
+        .context("prelude: waiting for the borrower's header")?;
+    check_template(&request, token.len(), server_name).context("borrower's header rejected")?;
+    let mut headers = request.template.clone();
+    let span = &mut headers[request.token.clone()];
+    span.fill(b' ');
+    span[..token.len()].copy_from_slice(token.as_bytes());
+    if let Some(tamper) = tamper {
+        tamper(&mut headers);
+    }
+
+    let config = ClientConfig::new(roots);
+    let mut conn = ClientConnection::new(
+        Arc::new(config),
+        leader,
+        ServerName::try_from(server_name)?,
+    )?;
+
+    let t = Instant::now();
+    conn.start().await?;
+    let mut buf = vec![0u8; 1 << 14];
+    loop {
+        flush_tls(&mut conn, &mut server).await?;
+        if !conn.is_handshaking() {
+            break;
+        }
+        let n = server.read(&mut buf).await?;
+        if n == 0 {
+            bail!("server closed the connection during the handshake");
+        }
+        let mut bytes = &buf[..n];
+        while !bytes.is_empty() {
+            // The deframer may take only part of the bytes when its buffer
+            // holds a partial record; feed it the rest after processing.
+            conn.read_tls(&mut bytes)?;
+            conn.process_new_packets().await?;
+        }
+    }
+    let handshake = t.elapsed();
+    info!(?handshake, "pool: handshake done");
+
+    // The header record carries the token. The borrower learns nothing about
+    // it; the server rejects the record if the pool changed anything else.
+    let t = Instant::now();
+    conn.write_hidden(&headers, request.token.clone()).await.context("queueing the header record")?;
+    conn.process_new_packets().await.context("encrypting the header record")?;
+    let hidden_record = flush_tls(&mut conn, &mut server).await.context("sending the header record")?;
+    conn.handoff().await.context("handing off the keys")?;
+    let handoff = t.elapsed();
+    info!(?handoff, "pool: header sent, keys handed off");
+
+    let relay = conn.take_relay().context("relay not available")?;
+    Ok::<_, anyhow::Error>((relay, conn, buf, server, headers, hidden_record, preprocess, handshake, handoff))
+    };
+    let (relay, mut conn, mut buf, server, headers, hidden_record, preprocess, handshake, handoff) =
+        tokio::time::timeout(SETUP_TIMEOUT, setup)
+            .await
+            .context("setup timed out")??;
+    let (mut commands, mut forwarder) = relay.split(to_borrower);
+
+    // Relay: records from the borrower go to the server, records from the
+    // server go to the borrower. The pool cannot read or alter either.
+    //
+    // Reads and writes on the server socket must not block each other, or
+    // the pool stalls writing a large body while the server stalls writing
+    // the response. Writes are queued and drained by their own select arm.
+    let (mut rd, mut wr) = tokio::io::split(server);
+    let deadline = tokio::time::sleep(RELAY_MAX_DURATION);
+    tokio::pin!(deadline);
+    let mut sent = 0usize;
+    let mut server_open = true;
+    // Set once the server's closing alert has been forwarded; from then on
+    // the borrower may leave at any moment, and that ends the borrow.
+    let mut server_done = false;
+    let mut out: Vec<u8> = Vec::new();
+    let mut written = 0;
+    loop {
+        tokio::select! {
+            // Stop taking records while the server is behind on the ones queued.
+            cmd = commands.next(), if out.len() - written < MAX_PENDING_BYTES => match cmd {
+                Ok(RelayCommand::Send(record)) => {
+                    sent += record.len();
+                    ensure!(sent <= MAX_SENT_BYTES, "borrower sent more than {MAX_SENT_BYTES} bytes");
+                    if server_open {
+                        debug!(len = record.len(), "pool: queueing the borrower's record");
+                        out.extend_from_slice(&record);
+                    } else {
+                        debug!("pool: dropping record for a closed server connection");
+                    }
+                }
+                Ok(RelayCommand::Done) => break,
+                // The borrower closing its end is also how a borrow ends.
+                Err(e) => {
+                    debug!("pool: borrower left: {e}");
+                    break;
+                }
+            },
+            // A fresh timer each round: idle means no record from either side.
+            _ = tokio::time::sleep(RELAY_IDLE_TIMEOUT) => {
+                bail!("relay idle for {} s", RELAY_IDLE_TIMEOUT.as_secs());
+            }
+            _ = &mut deadline => {
+                bail!("borrow ran for more than {} s", RELAY_MAX_DURATION.as_secs());
+            }
+            n = wr.write(&out[written..]), if written < out.len() => {
+                written += n.context("writing to the server")?;
+                if written == out.len() {
+                    out.clear();
+                    written = 0;
+                }
+            }
+            n = rd.read(&mut buf), if server_open => {
+                let n = n.context("reading from the server")?;
+                if n == 0 {
+                    server_open = false;
+                    // The borrower may already have left after the server's
+                    // close_notify; then there is nobody to tell.
+                    if forwarder.server_closed().await.is_err() {
+                        debug!("pool: borrower gone before the server closed");
+                        break;
+                    }
+                } else {
+                    let mut bytes = &buf[..n];
+                    while !bytes.is_empty() {
+                        if conn.read_tls(&mut bytes).context("deframing")? == 0 {
+                            bail!("deframer refused the server's bytes");
+                        }
+                        for frame in conn.take_frames() {
+                            debug!(typ = ?frame.typ, len = frame.payload.0.len(), "pool: forwarding a server record");
+                            let is_alert = frame.typ == ContentType::Alert;
+                            if let Err(e) = forwarder.forward(frame.encode()).await {
+                                if server_done {
+                                    debug!("pool: borrower left: {e}");
+                                    break;
+                                }
+                                return Err(anyhow::Error::from(e).context("forwarding a server record"));
+                            }
+                            server_done |= is_alert;
+                        }
+                    }
+                }
+            }
+        }
+    }
+    if server_open && written < out.len() {
+        wr.write_all(&out[written..]).await.context("writing the rest to the server")?;
+    }
+    let _ = wr.shutdown().await;
+
+    info!("pool: done");
+
+    Ok(PoolReport {
+        preprocess,
+        handshake,
+        handoff,
+        hidden_record,
+        headers,
+    })
+}
+
+/// Writes every queued TLS byte to the socket and returns what was written.
+async fn flush_tls<S>(conn: &mut ClientConnection, socket: &mut S) -> Result<Vec<u8>>
+where
+    S: AsyncWrite + Unpin,
+{
+    let mut all = Vec::new();
+    while conn.wants_write() {
+        let mut out = Vec::new();
+        conn.write_tls(&mut out)?;
+        socket.write_all(&out).await?;
+        all.extend_from_slice(&out);
+    }
+    Ok(all)
+}
+
+// ---------------------------------------------------------------------------
+// Borrower (follower)
+
+/// What the borrower got.
+#[derive(Debug)]
+pub struct BorrowerReport {
+    /// The whole response, headers included.
+    pub response: Vec<u8>,
+    /// Time from sending the body to the first response byte.
+    pub first_byte: Duration,
+    /// The traffic keys, for diagnostics in tests.
+    pub keys: TrafficKeys,
+    /// The header as the borrower asked for it (token span filled with x).
+    pub header: RequestHeader,
+}
+
+/// Runs the borrower's side of one borrowed request.
+///
+/// `template` is the header text with [`TOKEN_MARKER`] and optionally
+/// [`BODY_LEN_MARKER`]. `expected_server` is the name the borrower verifies
+/// the server's certificate for. `token_len` is the length of the credential
+/// the borrower expects; a pool announcing another length is refused, so the
+/// span can never be longer than a token. The response is copied to `out` as
+/// it arrives.
+#[allow(clippy::too_many_arguments)]
+pub async fn run_borrower(
+    ctx: Context,
+    mut from_pool: Context,
+    template: &str,
+    body: Vec<u8>,
+    roots: RootCertStore,
+    expected_server: &str,
+    token_len: usize,
+    mut out: Box<dyn AsyncWrite + Unpin + Send>,
+) -> Result<BorrowerReport> {
+    let hello: Hello = from_pool.io_mut().expect_next().await?;
+    info!(?hello, "borrower: pool says hello");
+    ensure!(
+        hello.version == PROTOCOL_VERSION,
+        "pool speaks protocol version {}, this borrower {PROTOCOL_VERSION}",
+        hello.version
+    );
+    let settings = hello.settings;
+    ensure!(
+        hello.token_len == token_len,
+        "pool announced a {}-byte token, expected {token_len}",
+        hello.token_len
+    );
+
+    // Only the part through the Authorization line is encrypted jointly; the
+    // remaining headers go in the borrower's own first record, before the body.
+    let (hidden, trailer) = split_template(template)?;
+    let header = fill_template(&hidden, token_len, body.len())?;
+    from_pool.io_mut().send(header.clone()).await?;
+
+    // The borrower garbles, always, whatever the pool says: see `mpc_parts`.
+    let (vm, cot_send, cot_recv) = mpc_parts(true);
+    let mut follower = MpcTlsFollower::new(
+        mpc_config(settings.low_bandwidth)?,
+        ctx,
+        vm,
+        cot_send,
+        (cot_recv.clone(), cot_recv.clone(), cot_recv),
+    );
+
+    follower.verify_server(roots, ServerName::try_from(expected_server)?);
+    follower.alloc()?;
+    follower.preprocess().await?;
+    info!("borrower: preprocessed");
+
+    // Everything up to and including the hand-off is driven by the pool. The
+    // borrower checks the server's certificate and signature itself, and
+    // only the header record it asked for may precede the hand-off.
+    let relay = tokio::time::timeout(
+        SETUP_TIMEOUT,
+        follower.run_until_handoff(HeaderTemplate {
+            text: header.template.clone(),
+            token: header.token.clone(),
+        }),
+    )
+    .await
+    .context("setup timed out")??;
+    info!(records = ?relay.records(), "borrower: holds the traffic keys");
+    let keys = relay.records().keys().clone();
+    let (mut writer, mut reader) = relay.split(from_pool);
+
+    // Read the response while the body is still being sent.
+    let t = Instant::now();
+    let reading = tokio::spawn(async move {
+        let mut response = Vec::new();
+        let mut first_byte = None;
+        loop {
+            match tokio::time::timeout(RELAY_IDLE_TIMEOUT, reader.recv())
+                .await
+                .context("no record from the pool for 10 min")??
+            {
+                RelayEvent::Record {
+                    typ: ContentType::ApplicationData,
+                    plaintext,
+                } => {
+                    first_byte.get_or_insert_with(|| t.elapsed());
+                    out.write_all(&plaintext).await?;
+                    out.flush().await?;
+                    response.extend_from_slice(&plaintext);
+                }
+                RelayEvent::Record {
+                    typ: ContentType::Alert,
+                    plaintext,
+                } => {
+                    let close_notify = [
+                        AlertLevel::Warning.get_u8(),
+                        AlertDescription::CloseNotify.get_u8(),
+                    ];
+                    ensure!(plaintext == close_notify, "unexpected alert: {plaintext:?}");
+                    debug!("borrower: server sent close_notify");
+                    break;
+                }
+                RelayEvent::Record { typ, .. } => bail!("unexpected record type {typ:?}"),
+                RelayEvent::ServerClosed => {
+                    debug!("borrower: server closed the connection");
+                    break;
+                }
+            }
+        }
+        Ok::<_, anyhow::Error>((response, first_byte.unwrap_or_default()))
+    });
+
+    writer.write(&[trailer, body].concat()).await?;
+    let (response, first_byte) = tokio::time::timeout(RELAY_MAX_DURATION, reading)
+        .await
+        .context("borrow ran too long")???;
+
+    writer.close_notify().await?;
+    writer.done().await?;
+    info!("borrower: done");
+
+    Ok(BorrowerReport {
+        response,
+        first_byte,
+        keys,
+        header,
+    })
+}
+
+// ---------------------------------------------------------------------------
+// MPC plumbing shared by both sides
+
+pub type CotSender = SharedRCOTSender<kos::Sender<co::Receiver>, Block>;
+pub type CotReceiver = SharedRCOTReceiver<kos::Receiver<co::Sender>, bool, Block>;
+
+/// Builds the VM and the correlated-OT endpoints for one party.
+///
+/// Both parties run a KOS sender and a KOS receiver: the MPC-TLS leader needs
+/// three senders and one receiver, the follower one sender and three
+/// receivers, and the garbler needs a sender while the evaluator needs a
+/// receiver. `garble` picks which of the two garbled-circuit roles this party
+/// takes; it is independent of the MPC-TLS role.
+///
+/// The orientation is fixed by [`run_pool`] and [`run_borrower`]: the
+/// borrower garbles, the pool evaluates. A garbler's inputs are private even
+/// against a malicious evaluator, but an evaluator's inputs are private only
+/// against a semi-honest garbler. The borrower's circuit inputs include the
+/// pads under which the traffic keys are revealed to it; the pool's are only
+/// its key shares and the span's one-time pad, both harmless if leaked (the
+/// shares reach the borrower at the hand-off anyway, and the span keystream
+/// is recomputable from the client key). So the borrower is the party that
+/// must garble, and neither side may be talked out of it.
+pub fn mpc_parts(garble: bool) -> (mpc_tls::Vm, CotSender, CotReceiver) {
+    let mut rng = rand::rng();
+    let delta = Delta::random(&mut rng);
+
+    let cot_send = SharedRCOTSender::new(kos::Sender::new(
+        kos::SenderConfig::default(),
+        delta.into_inner(),
+        co::Receiver::default(),
+    ));
+    let cot_recv = SharedRCOTReceiver::new(kos::Receiver::new(
+        kos::ReceiverConfig::default(),
+        co::Sender::default(),
+    ));
+
+    let vm: mpc_tls::Vm = if garble {
+        Arc::new(Mutex::new(Garbler::new(
+            DerandCOTSender::new(cot_send.clone()),
+            rng.random(),
+            delta,
+        )))
+    } else {
+        Arc::new(Mutex::new(Evaluator::new(DerandCOTReceiver::new(
+            cot_recv.clone(),
+        ))))
+    };
+
+    (vm, cot_send, cot_recv)
+}
+
+/// The MPC-TLS configuration both sides use.
+pub fn mpc_config(low_bandwidth: bool) -> Result<Config> {
+    let mut builder = Config::builder();
+    builder
+        // Only the header record is sent through MPC.
+        .max_sent(MAX_HEADER_LEN)
+        .hidden_record_len(MAX_HEADER_LEN)
+        // Nothing is received through MPC after the handshake.
+        .max_recv_online(0)
+        .max_recv(0);
+    if low_bandwidth {
+        builder.low_bandwidth();
+    }
+    Ok(builder.build()?)
+}
+
+/// Roots trusting tlsn's test server.
+pub fn fixture_roots() -> Result<RootCertStore> {
+    let der = CertificateDer::from_slice(tls_server_fixture::CA_CERT_DER);
+    let anchor = anchor_from_trusted_cert(&der)?.to_owned();
+    Ok(RootCertStore {
