new file mode 100644
index 0000000..5ff365c
--- /dev/null
+++ b/crates/mpc-tls/src/record_layer/header.rs
@@ -0,0 +1,122 @@
+//! The hidden header record.
+//!
+//! The record's plaintext is the follower's header text with one span, the
+//! token, filled in by the leader. The token never enters the joint
+//! computation: the circuit only produces keystream, the span's keystream is
+//! revealed to the leader alone, and the leader applies its token locally. The
+//! tag is computed so that the follower contributes its share for every block
+//! it knows from its own text, which binds the leader to that text: a record
+//! with any other byte outside the span fails authentication at the server.
+
+use std::ops::Range;
+
+use serde::{Deserialize, Serialize};
+
+use crate::MpcTlsError;
+
+/// Layout of a hidden header record: its length and the span the leader
+/// fills in.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct HeaderLayout {
+    /// Plaintext length in bytes.
+    pub len: usize,
+    /// Byte range of the leader's span (the token).
+    pub token: Range<usize>,
+}
+
+impl HeaderLayout {
+    /// Checks the layout is consistent and the span is aligned to 16-byte
+    /// blocks.
+    ///
+    /// Alignment is a security requirement: the leader controls every byte
+    /// of the GHASH blocks the span touches (see [`hidden_blocks`](Self::hidden_blocks)),
+    /// so an unaligned span would hand it up to 15 bytes of the follower's
+    /// text on each side.
+    pub fn validate(&self) -> Result<(), MpcTlsError> {
+        if self.token.start >= self.token.end || self.token.end > self.len {
+            return Err(MpcTlsError::record_layer(format!(
+                "invalid header layout: token span {:?} in {} bytes",
+                self.token, self.len
+            )));
+        }
+        if !self.token.start.is_multiple_of(16) || !self.token.len().is_multiple_of(16) {
+            return Err(MpcTlsError::record_layer(format!(
+                "token span {:?} is not aligned to 16-byte blocks",
+                self.token
+            )));
+        }
+        Ok(())
+    }
+
+    /// GHASH block indices the span touches, counting the AAD block as 0.
+    ///
+    /// Blocks the span only partly covers are included, so the leader also
+    /// controls the bytes sharing a block with the span. A span aligned to
+    /// 16-byte boundaries leaves it nothing outside the span.
+    pub fn hidden_blocks(&self) -> Vec<usize> {
+        let first = 1 + self.token.start / 16;
+        let last = 1 + (self.token.end - 1) / 16;
+        (first..=last).collect()
+    }
+
+    /// Number of GHASH blocks a span of up to `len` bytes can touch.
+    pub(crate) fn max_hidden_blocks(len: usize) -> usize {
+        len.div_ceil(16) + 1
+    }
+}
+
+/// The follower's view of the header record: its text, with anything in the
+/// token span, and the span.
+#[derive(Debug, Clone)]
+pub struct HeaderTemplate {
+    /// Header text; the bytes in `token` are ignored.
+    pub text: Vec<u8>,
+    /// Byte range the leader fills in.
+    pub token: Range<usize>,
+}
+
+impl HeaderTemplate {
+    /// Returns the layout this template expects.
+    pub fn layout(&self) -> HeaderLayout {
+        HeaderLayout {
+            len: self.text.len(),
+            token: self.token.clone(),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn hidden_blocks_follow_the_span() {
+        let aligned = HeaderLayout {
+            len: 200,
+            token: 48..160,
+        };
+        aligned.validate().unwrap();
+        assert_eq!(aligned.hidden_blocks(), (4..=10).collect::<Vec<_>>());
+        let unaligned = HeaderLayout {
+            len: 200,
+            token: 50..100,
+        };
+        // Partial blocks are the leader's too, which is why they are refused.
+        assert_eq!(unaligned.hidden_blocks(), vec![4, 5, 6, 7]);
+        assert!(unaligned.validate().is_err());
+        assert!(HeaderLayout::max_hidden_blocks(112) >= aligned.hidden_blocks().len());
+    }
+
+    #[test]
+    fn validate_rejects_bad_spans() {
+        for (len, token) in [(100, 16..16), (100, 16..112), (100, 8..24), (100, 16..40)] {
+            assert!(HeaderLayout { len, token }.validate().is_err());
+        }
+        HeaderLayout {
+            len: 100,
+            token: 16..48,
+        }
+        .validate()
+        .unwrap();
+    }
+}
