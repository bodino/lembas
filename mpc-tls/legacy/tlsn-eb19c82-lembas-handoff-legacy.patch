+//! Hand-off of the TLS traffic keys to the follower, and the relay that
+//! follows it.
+//!
+//! After the hand-off the follower holds both traffic keys and encrypts and
+//! decrypts application data locally. The leader keeps the connection to the
+//! server and relays records in both directions without being able to read or
+//! alter them: every record is protected by AES-GCM under keys the leader does
+//! not know, with the sequence number authenticated in the additional data.
+
+use std::array::from_fn;
+
+use aes_gcm::{Aes128Gcm, NewAead, aead::AeadMutInPlace};
+use mpz_common::Context;
+use mpz_core::bitvec::BitVec;
+use mpz_memory_core::{
+    Array, DecodeFutureTyped,
+    binary::{Binary, U8},
+};
+use mpz_vm_core::{Vm, prelude::*};
+use rand::RngExt;
+use serio::{SinkExt, stream::IoStreamExt};
+use tls_core::{
+    cipher::make_tls12_aad,
+    msgs::{
+        base::Payload,
+        codec::Reader,
+        enums::{AlertDescription, AlertLevel, ContentType, ProtocolVersion},
+        message::OpaqueMessage,
+    },
+};
+
+use crate::{MpcTlsError, Role, SessionKeys, mask::PreparedMask, msg::Message, utils::opaque_into_parts};
+
+/// Largest plaintext a single TLS record may carry.
+pub const MAX_RECORD_PLAINTEXT: usize = 1 << 14;
+
+/// The TLS 1.2 traffic keys, as revealed to the follower.
+#[derive(Clone)]
+pub struct TrafficKeys {
+    /// Client write key.
+    pub client_write_key: [u8; 16],
+    /// Client write IV (implicit nonce part).
+    pub client_write_iv: [u8; 4],
+    /// Server write key.
+    pub server_write_key: [u8; 16],
+    /// Server write IV (implicit nonce part).
+    pub server_write_iv: [u8; 4],
+}
+
+impl std::fmt::Debug for TrafficKeys {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("TrafficKeys").finish_non_exhaustive()
+    }
+}
+
+type Revealed<const N: usize> = (DecodeFutureTyped<BitVec, [u8; N]>, Option<[u8; N]>);
+
+/// Reveals the session keys to the follower only.
+///
+/// The follower masks each key with a one-time pad it chooses, the leader's
+/// mask is blind, and the masked value is decoded to both. Only the follower
+/// can remove the pad. This mirrors `AesGcm::decode_key`, which reveals the
+/// server key to the leader at commit, with the roles swapped. The pads are
+/// allocated at session setup so that they are preprocessed inputs.
+pub(crate) struct KeyHandoff {
+    role: Role,
+    keys: SessionKeys,
+    client_write_key: PreparedMask<Array<U8, 16>>,
+    client_write_iv: PreparedMask<Array<U8, 4>>,
+    server_write_key: PreparedMask<Array<U8, 16>>,
+    server_write_iv: PreparedMask<Array<U8, 4>>,
+    revealed: Option<(Revealed<16>, Revealed<4>, Revealed<16>, Revealed<4>)>,
+}
+
+impl std::fmt::Debug for KeyHandoff {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("KeyHandoff").finish_non_exhaustive()
+    }
+}
+
+impl KeyHandoff {
+    /// Allocates the pads. Call before preprocessing.
+    pub(crate) fn alloc(
+        role: Role,
+        vm: &mut dyn Vm<Binary>,
+        keys: &SessionKeys,
+    ) -> Result<Self, MpcTlsError> {
+        let owner = role == Role::Follower;
+        let mask = |vm: &mut dyn Vm<Binary>| -> Result<PreparedMask<Array<U8, 16>>, MpcTlsError> {
+            let pad = vm.alloc().map_err(MpcTlsError::record_layer)?;
+            PreparedMask::new(vm, pad, owner)
+        };
+        let client_write_key = mask(vm)?;
+        let server_write_key = mask(vm)?;
+        let mask_iv = |vm: &mut dyn Vm<Binary>| -> Result<PreparedMask<Array<U8, 4>>, MpcTlsError> {
+            let pad = vm.alloc().map_err(MpcTlsError::record_layer)?;
+            PreparedMask::new(vm, pad, owner)
+        };
+        let client_write_iv = mask_iv(vm)?;
+        let server_write_iv = mask_iv(vm)?;
+
+        Ok(Self {
+            role,
+            keys: keys.clone(),
+            client_write_key,
+            client_write_iv,
+            server_write_key,
+            server_write_iv,
+            revealed: None,
+        })
+    }
+
+    /// Queues the reveal. Execute the VM before [`finish`](Self::finish).
+    pub(crate) fn reveal(&mut self, vm: &mut dyn Vm<Binary>) -> Result<(), MpcTlsError> {
+        fn one<const N: usize>(
+            role: Role,
+            vm: &mut dyn Vm<Binary>,
+            mask: &mut PreparedMask<Array<U8, N>>,
+            value: Array<U8, N>,
+        ) -> Result<Revealed<N>, MpcTlsError> {
+            let otp: Option<[u8; N]> = match role {
+                Role::Follower => {
+                    let mut rng = rand::rng();
+                    Some(from_fn(|_| rng.random()))
+                }
+                Role::Leader => None,
+            };
+            let masked = mask.apply(vm, value, mask.pad(), otp)?;
+            let fut = vm.decode(masked).map_err(MpcTlsError::record_layer)?;
+            Ok((fut, otp))
+        }
+
+        if self.revealed.is_some() {
+            return Err(MpcTlsError::state("keys were already revealed"));
+        }
+
+        let keys = self.keys.clone();
+        self.revealed = Some((
+            one(self.role, vm, &mut self.client_write_key, keys.client_write_key)?,
+            one(self.role, vm, &mut self.client_write_iv, keys.client_write_iv)?,
+            one(self.role, vm, &mut self.server_write_key, keys.server_write_key)?,
+            one(self.role, vm, &mut self.server_write_iv, keys.server_write_iv)?,
+        ));
+
+        Ok(())
+    }
+
+    /// Returns the keys for the follower, `None` for the leader.
+    pub(crate) fn finish(self) -> Result<Option<TrafficKeys>, MpcTlsError> {
+        fn unmask<const N: usize>((mut fut, otp): Revealed<N>) -> Result<Option<[u8; N]>, MpcTlsError> {
+            let mut value = fut
+                .try_recv()
+                .map_err(MpcTlsError::record_layer)?
+                .ok_or_else(|| MpcTlsError::record_layer("key is not decoded"))?;
+            let Some(otp) = otp else {
+                return Ok(None);
+            };
+            value.iter_mut().zip(otp).for_each(|(a, b)| *a ^= b);
+            Ok(Some(value))
+        }
+
+        let (ck, civ, sk, siv) = self
+            .revealed
+            .ok_or_else(|| MpcTlsError::state("keys were not revealed"))?;
+
+        Ok(
+            match (unmask(ck)?, unmask(civ)?, unmask(sk)?, unmask(siv)?) {
+                (
+                    Some(client_write_key),
+                    Some(client_write_iv),
+                    Some(server_write_key),
+                    Some(server_write_iv),
+                ) => Some(TrafficKeys {
+                    client_write_key,
+                    client_write_iv,
+                    server_write_key,
+                    server_write_iv,
+                }),
+                _ => None,
+            },
+        )
+    }
+}
+
+/// Local TLS 1.2 AES-128-GCM record processing with the revealed keys.
+pub struct LocalRecordLayer {
+    keys: TrafficKeys,
+    writer: LocalRecordWriter,
+    reader: LocalRecordReader,
+}
+
+impl std::fmt::Debug for LocalRecordLayer {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("LocalRecordLayer")
+            .field("write_seq", &self.writer.write_seq)
+            .field("read_seq", &self.reader.read_seq)
+            .finish_non_exhaustive()
+    }
+}
+
+impl LocalRecordLayer {
+    /// Creates a record layer continuing from the given sequence numbers.
+    pub fn new(keys: &TrafficKeys, write_seq: u64, read_seq: u64) -> Self {
+        Self {
+            keys: keys.clone(),
+            writer: LocalRecordWriter::new(keys, write_seq),
+            reader: LocalRecordReader::new(keys, read_seq),
+        }
+    }
+
+    /// Returns the traffic keys.
+    pub fn keys(&self) -> &TrafficKeys {
+        &self.keys
+    }
+
+    /// Returns the next write and read sequence numbers.
+    pub fn seqs(&self) -> (u64, u64) {
+        (self.writer.write_seq, self.reader.read_seq)
+    }
+
+    /// Encrypts one record and returns it encoded, ready for the wire.
+    pub fn encrypt(&mut self, typ: ContentType, plaintext: &[u8]) -> Result<Vec<u8>, MpcTlsError> {
+        self.writer.encrypt(typ, plaintext)
+    }
+
+    /// Decrypts one encoded record received from the server.
+    pub fn decrypt(&mut self, record: &[u8]) -> Result<(ContentType, Vec<u8>), MpcTlsError> {
+        self.reader.decrypt(record)
+    }
+
+    /// Splits into the sending and the receiving half.
+    pub fn split(self) -> (LocalRecordWriter, LocalRecordReader) {
+        (self.writer, self.reader)
+    }
+}
+
+/// Encrypts records to the server under the client write key.
+pub struct LocalRecordWriter {
+    client: Aes128Gcm,
+    client_iv: [u8; 4],
+    write_seq: u64,
+}
+
+impl std::fmt::Debug for LocalRecordWriter {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("LocalRecordWriter")
+            .field("write_seq", &self.write_seq)
+            .finish_non_exhaustive()
+    }
+}
+
+impl LocalRecordWriter {
+    fn new(keys: &TrafficKeys, write_seq: u64) -> Self {
+        Self {
+            client: Aes128Gcm::new((&keys.client_write_key).into()),
+            client_iv: keys.client_write_iv,
+            write_seq,
+        }
+    }
+
+    /// Encrypts one record and returns it encoded, ready for the wire.
+    pub fn encrypt(&mut self, typ: ContentType, plaintext: &[u8]) -> Result<Vec<u8>, MpcTlsError> {
+        if plaintext.len() > MAX_RECORD_PLAINTEXT {
+            return Err(MpcTlsError::record_layer(format!(
+                "record plaintext too long: {} > {MAX_RECORD_PLAINTEXT}",
+                plaintext.len()
+            )));
+        }
+
+        let seq = self.write_seq;
+        self.write_seq += 1;
+
+        let version = ProtocolVersion::TLSv1_2;
+        let explicit_nonce = seq.to_be_bytes();
+        let mut nonce = [0u8; 12];
+        nonce[..4].copy_from_slice(&self.client_iv);
+        nonce[4..].copy_from_slice(&explicit_nonce);
+        let aad = make_tls12_aad(seq, typ, version, plaintext.len());
+
+        let mut payload = Vec::with_capacity(8 + plaintext.len() + 16);
+        payload.extend_from_slice(&explicit_nonce);
+        payload.extend_from_slice(plaintext);
+        let tag = self
+            .client
+            .encrypt_in_place_detached((&nonce).into(), &aad, &mut payload[8..])
+            .map_err(|_| MpcTlsError::record_layer("encryption failed"))?;
+        payload.extend_from_slice(&tag);
+
+        Ok(OpaqueMessage {
+            typ,
+            version,
+            payload: Payload::new(payload),
+        }
+        .encode())
+    }
+}
+
+/// Decrypts records from the server under the server write key.
+pub struct LocalRecordReader {
+    server: Aes128Gcm,
+    server_iv: [u8; 4],
+    read_seq: u64,
+}
+
+impl std::fmt::Debug for LocalRecordReader {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("LocalRecordReader")
+            .field("read_seq", &self.read_seq)
+            .finish_non_exhaustive()
+    }
+}
+
+impl LocalRecordReader {
+    fn new(keys: &TrafficKeys, read_seq: u64) -> Self {
+        Self {
+            server: Aes128Gcm::new((&keys.server_write_key).into()),
+            server_iv: keys.server_write_iv,
+            read_seq,
+        }
+    }
+
+    /// Decrypts one encoded record received from the server.
+    pub fn decrypt(&mut self, record: &[u8]) -> Result<(ContentType, Vec<u8>), MpcTlsError> {
+        let mut reader = Reader::init(record);
+        let msg = OpaqueMessage::read(&mut reader)
+            .map_err(|_| MpcTlsError::record_layer("malformed record"))?;
+        if reader.any_left() {
+            return Err(MpcTlsError::record_layer("trailing bytes after record"));
+        }
+
+        let (explicit_nonce, mut ciphertext, tag) = opaque_into_parts(msg.payload.0)?;
+
+        let seq = self.read_seq;
+        self.read_seq += 1;
+
+        let mut nonce = [0u8; 12];
+        nonce[..4].copy_from_slice(&self.server_iv);
+        nonce[4..].copy_from_slice(&explicit_nonce);
+        let aad = make_tls12_aad(seq, msg.typ, msg.version, ciphertext.len());
+
+        self.server
+            .decrypt_in_place_detached(
+                (&nonce).into(),
+                &aad,
+                &mut ciphertext,
+                tag.as_slice().into(),
+            )
+            .map_err(|_| MpcTlsError::record_layer("tag verification failed"))?;
+
+        Ok((msg.typ, ciphertext))
+    }
+}
+
+/// What the follower receives from the leader during the relay.
+#[derive(Debug)]
+pub enum RelayEvent {
+    /// A decrypted record from the server.
+    Record {
+        /// Content type.
+        typ: ContentType,
+        /// Plaintext.
+        plaintext: Vec<u8>,
+    },
+    /// The server closed the connection.
+    ServerClosed,
+}
+
+/// The follower's side of the connection after the hand-off.
+#[derive(Debug)]
+pub struct FollowerRelay {
+    ctx: Context,
+    records: LocalRecordLayer,
+}
+
+impl FollowerRelay {
+    pub(crate) fn new(ctx: Context, records: LocalRecordLayer) -> Self {
+        Self { ctx, records }
+    }
+
+    /// Returns the local record layer.
+    pub fn records(&self) -> &LocalRecordLayer {
+        &self.records
+    }
+
+    /// Encrypts one record and sends it to the leader for forwarding.
+    pub async fn send(&mut self, typ: ContentType, plaintext: &[u8]) -> Result<(), MpcTlsError> {
+        let record = self.records.encrypt(typ, plaintext)?;
+        self.ctx.io_mut().send(Message::Outgoing(record)).await?;
+        Ok(())
+    }
+
+    /// Sends application data, split into records as needed.
+    pub async fn write(&mut self, data: &[u8]) -> Result<(), MpcTlsError> {
+        for chunk in data.chunks(MAX_RECORD_PLAINTEXT) {
+            self.send(ContentType::ApplicationData, chunk).await?;
+        }
+        Ok(())
+    }
+
+    /// Sends a `close_notify` alert.
+    pub async fn close_notify(&mut self) -> Result<(), MpcTlsError> {
+        let alert = [
+            AlertLevel::Warning.get_u8(),
+            AlertDescription::CloseNotify.get_u8(),
+        ];
+        self.send(ContentType::Alert, &alert).await
+    }
+
+    /// Waits for the next record from the server, or for the server to close.
+    pub async fn recv(&mut self) -> Result<RelayEvent, MpcTlsError> {
+        let msg: Message = self.ctx.io_mut().expect_next().await?;
+        match msg {
+            Message::Incoming(record) => {
+                let (typ, plaintext) = self.records.decrypt(&record)?;
+                Ok(RelayEvent::Record { typ, plaintext })
+            }
+            Message::ServerClosed => Ok(RelayEvent::ServerClosed),
+            other => Err(MpcTlsError::peer(format!(
+                "unexpected message during relay: {other:?}"
+            ))),
+        }
+    }
+
+    /// Tells the leader the follower is done and returns the context.
+    pub async fn done(mut self) -> Result<Context, MpcTlsError> {
+        self.ctx.io_mut().send(Message::Done).await?;
+        Ok(self.ctx)
+    }
+
+    /// Splits the relay so that sending and receiving can run concurrently.
+    ///
+    /// Records to the server keep using this relay's channel; records from
+    /// the server arrive on `from_leader`, a second channel the leader opened
+    /// in the same order (see [`LeaderRelay::split`]). Without the split, a
+    /// party that only reads after it has finished writing deadlocks with the
+    /// other side once the channel's window is full.
+    pub fn split(self, from_leader: Context) -> (FollowerWriter, FollowerReader) {
+        let (writer, reader) = self.records.split();
+        (
+            FollowerWriter {
+                ctx: self.ctx,
+                writer,
+            },
+            FollowerReader {
+                ctx: from_leader,
+                reader,
+            },
+        )
+    }
+}
+
+/// The sending half of a split [`FollowerRelay`].
+#[derive(Debug)]
+pub struct FollowerWriter {
+    ctx: Context,
+    writer: LocalRecordWriter,
+}
+
+impl FollowerWriter {
+    /// Encrypts one record and sends it to the leader for forwarding.
+    pub async fn send(&mut self, typ: ContentType, plaintext: &[u8]) -> Result<(), MpcTlsError> {
+        let record = self.writer.encrypt(typ, plaintext)?;
+        self.ctx.io_mut().send(Message::Outgoing(record)).await?;
+        Ok(())
+    }
+
+    /// Sends application data, split into records as needed.
+    pub async fn write(&mut self, data: &[u8]) -> Result<(), MpcTlsError> {
+        for chunk in data.chunks(MAX_RECORD_PLAINTEXT) {
+            self.send(ContentType::ApplicationData, chunk).await?;
+        }
+        Ok(())
+    }
+
+    /// Sends a `close_notify` alert.
+    pub async fn close_notify(&mut self) -> Result<(), MpcTlsError> {
+        let alert = [
+            AlertLevel::Warning.get_u8(),
+            AlertDescription::CloseNotify.get_u8(),
+        ];
+        self.send(ContentType::Alert, &alert).await
+    }
+
+    /// Tells the leader the follower is done and returns the context.
+    pub async fn done(mut self) -> Result<Context, MpcTlsError> {
+        self.ctx.io_mut().send(Message::Done).await?;
+        Ok(self.ctx)
+    }
+}
+
+/// The receiving half of a split [`FollowerRelay`].
+#[derive(Debug)]
+pub struct FollowerReader {
+    ctx: Context,
+    reader: LocalRecordReader,
+}
+
+impl FollowerReader {
+    /// Waits for the next record from the server, or for the server to close.
+    pub async fn recv(&mut self) -> Result<RelayEvent, MpcTlsError> {
+        let msg: Message = self.ctx.io_mut().expect_next().await?;
+        match msg {
+            Message::Incoming(record) => {
+                let (typ, plaintext) = self.reader.decrypt(&record)?;
+                Ok(RelayEvent::Record { typ, plaintext })
+            }
+            Message::ServerClosed => Ok(RelayEvent::ServerClosed),
+            other => Err(MpcTlsError::peer(format!(
+                "unexpected message during relay: {other:?}"
+            ))),
+        }
+    }
+
+    /// Returns the context.
+    pub fn into_context(self) -> Context {
+        self.ctx
+    }
+}
+
+/// What the leader receives from the follower during the relay.
+#[derive(Debug)]
+pub enum RelayCommand {
+    /// An encoded record to send to the server.
+    Send(Vec<u8>),
+    /// The follower is done.
+    Done,
+}
+
+/// The leader's side of the connection after the hand-off.
+#[derive(Debug)]
+pub struct LeaderRelay {
+    ctx: Context,
+}
+
+impl LeaderRelay {
+    pub(crate) fn new(ctx: Context) -> Self {
+        Self { ctx }
+    }
+
+    /// Waits for the follower's next command.
+    pub async fn next(&mut self) -> Result<RelayCommand, MpcTlsError> {
+        let msg: Message = self.ctx.io_mut().expect_next().await?;
+        match msg {
+            Message::Outgoing(record) => Ok(RelayCommand::Send(record)),
+            Message::Done => Ok(RelayCommand::Done),
+            other => Err(MpcTlsError::peer(format!(
+                "unexpected message during relay: {other:?}"
+            ))),
+        }
+    }
+
+    /// Forwards an encoded record received from the server.
+    pub async fn forward(&mut self, record: Vec<u8>) -> Result<(), MpcTlsError> {
+        self.ctx.io_mut().send(Message::Incoming(record)).await?;
+        Ok(())
+    }
+
+    /// Tells the follower the server closed the connection.
+    pub async fn server_closed(&mut self) -> Result<(), MpcTlsError> {
+        self.ctx.io_mut().send(Message::ServerClosed).await?;
+        Ok(())
+    }
+
+    /// Returns the context.
+    pub fn into_context(self) -> Context {
+        self.ctx
+    }
+
+    /// Splits the relay so that the two directions use separate channels.
+    ///
+    /// Commands from the follower keep arriving on this relay's channel;
+    /// records from the server are forwarded on `to_follower`, a second
+    /// channel both parties opened in the same order.
+    pub fn split(self, to_follower: Context) -> (LeaderCommands, LeaderForwarder) {
+        (
+            LeaderCommands { ctx: self.ctx },
+            LeaderForwarder { ctx: to_follower },
+        )
+    }
+}
+
+/// The command half of a split [`LeaderRelay`].
+#[derive(Debug)]
+pub struct LeaderCommands {
+    ctx: Context,
+}
+
+impl LeaderCommands {
+    /// Waits for the follower's next command.
+    pub async fn next(&mut self) -> Result<RelayCommand, MpcTlsError> {
+        let msg: Message = self.ctx.io_mut().expect_next().await?;
+        match msg {
+            Message::Outgoing(record) => Ok(RelayCommand::Send(record)),
+            Message::Done => Ok(RelayCommand::Done),
+            other => Err(MpcTlsError::peer(format!(
+                "unexpected message during relay: {other:?}"
+            ))),
+        }
+    }
+
+    /// Returns the context.
+    pub fn into_context(self) -> Context {
+        self.ctx
+    }
+}
+
+/// The forwarding half of a split [`LeaderRelay`].
+#[derive(Debug)]
+pub struct LeaderForwarder {
+    ctx: Context,
+}
+
+impl LeaderForwarder {
+    /// Forwards an encoded record received from the server.
+    pub async fn forward(&mut self, record: Vec<u8>) -> Result<(), MpcTlsError> {
+        self.ctx.io_mut().send(Message::Incoming(record)).await?;
+        Ok(())
+    }
+
+    /// Tells the follower the server closed the connection.
+    pub async fn server_closed(&mut self) -> Result<(), MpcTlsError> {
+        self.ctx.io_mut().send(Message::ServerClosed).await?;
+        Ok(())
+    }
+
+    /// Returns the context.
+    pub fn into_context(self) -> Context {
+        self.ctx
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn local_record_layer_round_trips() {
+        let keys = TrafficKeys {
+            client_write_key: [1; 16],
+            client_write_iv: [2; 4],
+            server_write_key: [1; 16],
+            server_write_iv: [2; 4],
+        };
+        // Same key both ways, so a record we write can be read back as if
+        // it came from the server.
+        let mut layer = LocalRecordLayer::new(&keys, 3, 3);
+        let record = layer.encrypt(ContentType::ApplicationData, b"hello").unwrap();
+        let (typ, plaintext) = layer.decrypt(&record).unwrap();
+        assert_eq!(typ, ContentType::ApplicationData);
+        assert_eq!(plaintext, b"hello");
+        assert_eq!(layer.seqs(), (4, 4));
+
+        // A wrong sequence number fails authentication.
+        let mut layer = LocalRecordLayer::new(&keys, 3, 4);
+        let record = layer.encrypt(ContentType::ApplicationData, b"hello").unwrap();
+        assert!(layer.decrypt(&record).is_err());
+    }
+}
