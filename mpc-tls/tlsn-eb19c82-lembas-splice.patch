+//! Borrowed requests with a spliced token record.
+//!
+//! The **borrower** runs an ordinary TLS session to the API server through a
+//! relay operated by the **pool**, which holds the token. The pool writes
+//! exactly one record into that session, the one carrying the token, and can
+//! read or forge nothing else; the borrower never learns the token. The
+//! protocol is in [`splice`]; this module holds what both sides share: the
+//! template policy, the wire prelude, the link plumbing.
+//!
+//! The link between pool and borrower must itself be authenticated (in
+//! lembas, the existing pool WebSocket over TLS). A man in the middle on it
+//! can only cause failures, never read or forge, but the pool must know it is
+//! lending to a member.
+//!
+//! The pool and the borrower talk over one byte stream multiplexed by
+//! tlsn-mux. Each side opens three channels in the same order: `mpc` for the
+//! two-party computation, `up` for everything the borrower sends, `down` for
+//! everything the pool sends.
+
+use std::{future::Future, ops::Range, pin::Pin, time::Duration};
+
+use anyhow::{Context as _, Result, bail, ensure};
+use mpz_common::{Context, Session, ThreadPool, ThreadPoolBuildError, mux::Mux};
+use rustls_pki_types::CertificateDer;
+use serde::{Deserialize, Serialize};
+use webpki::anchor_from_trusted_cert;
+
+pub mod record;
+pub mod splice;
+
+/// Largest token record the pool may send: the request line, Host,
+/// Content-Length and the bearer line, about 210 bytes in practice. Each
+/// 16-byte block is one AES block proven in zero knowledge, so this budget is
+/// kept tight; the other headers follow in a record the borrower encrypts
+/// alone.
+pub const MAX_HEADER_LEN: usize = 320;
+
+/// Marker in a borrower's template that becomes the token span.
+pub const TOKEN_MARKER: &str = "{token}";
+/// Marker in a borrower's template that becomes the body length.
+pub const BODY_LEN_MARKER: &str = "{body_len}";
+
+/// How long the prelude, preprocessing, handshake and splice may take.
+/// The relay itself is bounded separately: a model may stream for minutes.
+pub const SETUP_TIMEOUT: Duration = Duration::from_secs(90);
+/// How long the relay waits for the next frame from either side before it
+/// gives up. Long enough for a model's thinking pause (the lembas agent's own
+/// request timeout is the same 10 minutes), short enough that a vanished peer
+/// does not hold the pool's helper forever.
+pub const RELAY_IDLE_TIMEOUT: Duration = Duration::from_secs(600);
+/// The most a single borrow may last, idle or not.
+pub const RELAY_MAX_DURATION: Duration = Duration::from_secs(3600);
+/// Largest body a template may announce in `Content-Length`. The pool cannot
+/// read the body, so the announced length and the bytes actually relayed are
+/// its only levers against a borrower spending a lender's quota on huge
+/// requests.
+pub const MAX_BODY_LEN: usize = 64 << 20;
+/// Most bytes the pool relays from the borrower to the server in one borrow:
+/// the announced body plus record framing, with room to spare.
+pub const MAX_SENT_BYTES: usize = MAX_BODY_LEN + (4 << 20);
+/// Bytes from the borrower waiting to be written to a slow server; beyond
+/// this the pool stops reading until the server catches up.
+pub const MAX_PENDING_BYTES: usize = 4 << 20;
+/// Changes whenever `Hello` or what follows it changes; the wire codec is not
+/// self-describing, so this is what turns an old peer into a clean error.
+pub const PROTOCOL_VERSION: u32 = 4;
+
+/// The pool's opening message.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct Hello {
+    /// [`PROTOCOL_VERSION`]; the borrower refuses any other.
+    pub version: u32,
+    /// Length of the token the pool will put in the span.
+    pub token_len: usize,
+    /// Server the pool connects to; the borrower's `Host` must match.
+    pub server_name: String,
+}
+
+/// The borrower's request header: the part that becomes the pool's record.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct RequestHeader {
+    /// Header text through the Authorization line, with any bytes in `token`.
+    pub template: Vec<u8>,
+    /// Span the pool fills with the token.
+    pub token: Range<usize>,
+}
+
+/// Length of a subscription token (`sk-ant-oat01-…`) or API key
+/// (`sk-ant-api03-…`); both are 108 bytes.
+///
+/// This is a security invariant, not a convenience: the token span is
+/// `TOKEN_LEN` rounded up to 16-byte blocks, and the slack a pool has for
+/// smuggling bytes into the span is `span - token`. With a 108-byte token
+/// that is 4 bytes, too few for a header. A shorter credential in the same
+/// span would leave room: 112 - 97 = 15 bytes fit `\r\nX: value`. So the
+/// pool refuses to lend any credential of another length, and the borrower
+/// refuses a pool announcing another length.
+pub const TOKEN_LEN: usize = 108;
+
+/// Rounds a span length up to whole 16-byte blocks.
+fn span_len_for(token_len: usize) -> usize {
+    token_len.div_ceil(16) * 16
+}
+
+/// Checks a borrower's template on the pool's side.
+///
+/// The span must be exactly the value of an `Authorization: Bearer` header,
+/// so the token can only ever land where a bearer token belongs, never in a
+/// path or a header the server might echo. It must be block aligned and no
+/// more than 15 bytes longer than the token, which with a working token
+/// leaves the pool no room for anything else (see `fill_template`). `Host`
+/// must name the server the pool connects to.
+pub fn check_template(header: &RequestHeader, token_len: usize, server_name: &str) -> Result<()> {
+    ensure!(
+        token_len == TOKEN_LEN,
+        "only {TOKEN_LEN}-byte credentials can be lent, see TOKEN_LEN"
+    );
+    let text = &header.template;
+    ensure!(
+        text.len() <= MAX_HEADER_LEN,
+        "header is {} bytes; at most {MAX_HEADER_LEN} can be sent",
+        text.len()
+    );
+    ensure!(
+        text.ends_with(b"\r\n") && !text.ends_with(b"\r\n\r\n"),
+        "the token record ends with the Authorization line, not the blank line"
+    );
+    let span = header.token.clone();
+    ensure!(
+        span.start < span.end && span.end <= text.len(),
+        "token span must be inside the header"
+    );
+    ensure!(
+        span.len() == span_len_for(token_len) && span.start.is_multiple_of(16),
+        "token span must be the token length rounded up to 16-byte blocks, block aligned"
+    );
+    ensure!(
+        span.end + 2 == text.len(),
+        "the Authorization line must be the last line of the token record"
+    );
+    let head = std::str::from_utf8(&text[..text.len() - 2]).context("header is not UTF-8")?;
+    ensure!(!head.contains("\r\n\r\n"), "header contains a blank line");
+
+    let mut pos = 0;
+    let mut saw_auth = false;
+    let mut saw_host = false;
+    let mut saw_length = false;
+    let mut names = std::collections::HashSet::new();
+    for (i, line) in head.split("\r\n").enumerate() {
+        let line_range = pos..pos + line.len();
+        pos += line.len() + 2;
+        if i == 0 {
+            ensure!(line.ends_with(" HTTP/1.1"), "first line must be an HTTP/1.1 request line");
+            ensure!(line.matches(' ').count() == 2, "malformed request line");
+            continue;
+        }
+        let (name, value) = line.split_once(':').context("malformed header line")?;
+        let name = name.trim().to_ascii_lowercase();
+        ensure!(names.insert(name.clone()), "header {name} appears twice");
+        let value = value.trim_start();
+        let value_start = line_range.start + (line.len() - value.len());
+        if name == "authorization" {
+            ensure!(!saw_auth, "more than one Authorization header");
+            saw_auth = true;
+            let rest = value
+                .strip_prefix("Bearer")
+                .context("Authorization must be a bearer token")?;
+            let spaces = rest.len() - rest.trim_start_matches(' ').len();
+            ensure!(spaces >= 1, "Authorization must be a bearer token");
+            let expected = value_start + "Bearer".len() + spaces..line_range.end;
+            ensure!(
+                span == expected,
+                "token span must be exactly the bearer token value"
+            );
+        } else {
+            ensure!(
+                span.start >= line_range.end || span.end <= line_range.start,
+                "token span overlaps a header other than Authorization"
+            );
+            if name == "host" {
+                ensure!(!saw_host, "more than one Host header");
+                ensure!(value.trim_end() == server_name, "Host must be {server_name}");
+                saw_host = true;
+            }
+            if name == "content-length" {
+                let len: usize = value.trim_end().parse().context("Content-Length is not a number")?;
+                ensure!(len <= MAX_BODY_LEN, "Content-Length {len} is over the {MAX_BODY_LEN}-byte limit");
+                saw_length = true;
+            }
+        }
+    }
+    ensure!(saw_auth, "no Authorization header");
+    ensure!(saw_host, "no Host header");
+    ensure!(saw_length, "no Content-Length header");
+    Ok(())
+}
+
+/// Splits a full header template (ending in a blank line) at the line that
+/// carries the token: the first part becomes the pool's record, the rest
+/// (remaining headers plus the blank line) is sent by the borrower alone,
+/// ahead of the body. Fewer bytes in the pool's record means fewer AES blocks
+/// to prove, so callers put Authorization right after Host and Content-Length.
+pub fn split_template(template: &str) -> Result<(String, Vec<u8>)> {
+    ensure!(
+        template.ends_with("\r\n\r\n"),
+        "template must end with a blank line"
+    );
+    let marker = template
+        .find(TOKEN_MARKER)
+        .context("template has no {token}")?;
+    let line_end = template[marker..]
+        .find("\r\n")
+        .map(|i| marker + i + 2)
+        .unwrap();
+    let (hidden, rest) = template.split_at(line_end);
+    Ok((hidden.to_string(), rest.as_bytes().to_vec()))
+}
+
+/// Builds the borrower's header from a template with markers.
+///
+/// The token span is pinned to `token_len` rounded up to whole 16-byte blocks
+/// and aligned to a block boundary by padding the end of the preceding header
+/// line with spaces (optional whitespace, which servers strip). The pool fills
+/// the span with its token followed by spaces. A pool that put anything but a
+/// token in the span would break its own credential, and the alignment leaves
+/// it no byte outside the span, so it cannot smuggle in a header.
+pub fn fill_template(template: &str, token_len: usize, body_len: usize) -> Result<RequestHeader> {
+    ensure!(
+        template.matches(TOKEN_MARKER).count() == 1,
+        "template must contain {TOKEN_MARKER} exactly once"
+    );
+    let span_len = span_len_for(token_len);
+    let mut text = template.replace(BODY_LEN_MARKER, &body_len.to_string());
+    let marker = text.find(TOKEN_MARKER).unwrap();
+    let line_start = text[..marker]
+        .rfind("\r\n")
+        .context("the Authorization header must not be the first line")?;
+    ensure!(
+        text[..line_start].contains("\r\n"),
+        "put at least one header before Authorization: the line before it is padded for alignment"
+    );
+    let pad = (16 - marker % 16) % 16;
+    text.insert_str(line_start, &" ".repeat(pad));
+    let start = marker + pad;
+    text.replace_range(start..start + TOKEN_MARKER.len(), &"x".repeat(span_len));
+    // The pool's record ends with the Authorization line; the blank line
+    // comes later, in the borrower's own record (see `split_template`).
+    let mut template = text.into_bytes();
+    ensure!(
+        template.ends_with(b"\r\n") && !template.ends_with(b"\r\n\r\n"),
+        "the pool's record must end right after the Authorization line"
+    );
+    while template.ends_with(b"\r\n\r\n") {
+        template.truncate(template.len() - 2);
+    }
+    Ok(RequestHeader {
+        template,
+        token: start..start + span_len,
+    })
+}
+
+/// Test hook: a misbehaving pool's change to the header after the token is
+/// in place.
+pub type Tamper = Option<Box<dyn FnOnce(&mut Vec<u8>) + Send>>;
+
+/// Roots trusting tlsn's test server.
+pub fn fixture_roots() -> Result<rustls::RootCertStore> {
+    let der = CertificateDer::from_slice(tls_server_fixture::CA_CERT_DER);
+    let anchor = anchor_from_trusted_cert(&der)?.to_owned();
+    Ok(rustls::RootCertStore {
+        roots: vec![anchor],
+    })
+}
+
+/// Mozilla's roots, for real servers.
+pub fn mozilla_roots() -> rustls::RootCertStore {
+    rustls::RootCertStore {
+        roots: webpki_roots::TLS_SERVER_ROOTS.to_vec(),
+    }
+}
+
+/// Multiplexed session over one byte stream, as tlsn does it. The returned
+/// sender closes the session; the driver then runs until the peer agrees.
+#[allow(clippy::type_complexity)]
+pub fn session<Io>(
+    io: Io,
+) -> Result<(
+    Session,
+    Pin<Box<dyn Future<Output = Result<()>> + Send>>,
+    tokio::sync::oneshot::Sender<()>,
+)>
+where
+    Io: futures::AsyncRead + futures::AsyncWrite + Unpin + Send + 'static,
+{
+    struct MuxHandle(tlsn_mux::Handle);
+
+    impl std::fmt::Debug for MuxHandle {
+        fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+            f.write_str("MuxHandle")
+        }
+    }
+
+    impl Mux for MuxHandle {
+        fn open(&self, id: &[u8]) -> Result<mpz_common::io::Io, std::io::Error> {
+            let stream = self.0.new_stream(id).map_err(std::io::Error::other)?;
+            Ok(mpz_common::io::Io::from_io(stream))
+        }
+    }
+
+    let config = tlsn_mux::Config::builder()
+        .keep_alive(true)
+        .close_sync(true)
+        .build()?;
+    let mut conn = tlsn_mux::Connection::new(io, config);
+    let handle = conn.handle()?;
+
+    let cores = std::thread::available_parallelism()
+        .map(|n| n.get())
+        .unwrap_or(8);
+    match ThreadPool::builder().num_threads(cores).build_global() {
+        Ok(()) | Err(ThreadPoolBuildError::AlreadyInitialized) => {}
+        Err(e) => bail!("thread pool: {e}"),
+    }
+
+    let session = Session::builder()
+        .pool(ThreadPool::global())
+        .build(MuxHandle(handle))?;
+
+    // Drive the mux; close it when asked, then run until the peer agrees.
+    let (close_tx, mut close_rx) = tokio::sync::oneshot::channel::<()>();
+    let driver = Box::pin(async move {
+        let mut closing = false;
+        futures::future::poll_fn(|cx| {
+            if !closing && Pin::new(&mut close_rx).poll(cx).is_ready() {
+                closing = true;
+                conn.close();
+            }
+            conn.poll(cx)
+        })
+        .await?;
+        Ok(())
+    });
+
+    Ok((session, driver, close_tx))
+}
+
+/// A connection with three channels opened in the order both sides agree on.
+pub struct Link {
+    pub session: Session,
+    pub driver: Pin<Box<dyn Future<Output = Result<()>> + Send>>,
+    pub close: tokio::sync::oneshot::Sender<()>,
+    /// The two-party computation.
+    pub mpc: Context,
+    /// Everything the borrower sends.
+    pub up: Context,
+    /// Everything the pool sends.
+    pub down: Context,
+}
+
+/// Opens a link over `io`.
+pub fn link<Io>(io: Io) -> Result<Link>
+where
+    Io: futures::AsyncRead + futures::AsyncWrite + Unpin + Send + 'static,
+{
+    let (session, driver, close) = session(io)?;
+    let mpc = session.new_context()?;
+    let up = session.new_context()?;
+    let down = session.new_context()?;
+    Ok(Link {
+        session,
+        driver,
+        close,
+        mpc,
+        up,
+        down,
+    })
+}
+
+/// Decodes an HTTP/1.1 chunked body; returns the input unchanged if it is not
+/// chunked.
+pub fn dechunk(body: &[u8]) -> Vec<u8> {
+    let mut out = Vec::new();
+    let mut rest = body;
+    loop {
+        let Some(eol) = rest.windows(2).position(|w| w == b"\r\n") else {
+            return body.to_vec();
+        };
+        let Ok(size) = usize::from_str_radix(std::str::from_utf8(&rest[..eol]).unwrap_or("x"), 16)
+        else {
+            return body.to_vec();
+        };
+        rest = &rest[eol + 2..];
+        if size == 0 {
+            return out;
+        }
+        // A hostile size would overflow `size + 2`; check before adding.
+        if size > rest.len() || rest.len() < size + 2 {
+            return body.to_vec();
+        }
+        out.extend_from_slice(&rest[..size]);
+        rest = &rest[size + 2..];
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn header(text: &str) -> RequestHeader {
+        fill_template(&split_template(text).unwrap().0, 8, 5).unwrap()
+    }
+
+    #[test]
+    fn template_is_pinned_and_aligned() {
+        let ok = header(
+            "POST /v1/messages HTTP/1.1\r\nHost: api.example\r\nContent-Length: {body_len}\r\nAuthorization: Bearer {token}\r\n\r\n",
+        );
+        assert_eq!(ok.token.start % 16, 0);
+        assert_eq!(ok.token.len(), 16);
+        assert_eq!(ok.template.len(), ok.token.end + 2);
+        let text = String::from_utf8(ok.template.clone()).unwrap();
+        assert!(text.ends_with("Bearer xxxxxxxxxxxxxxxx\r\n"));
+        // Only the real credential length is lent (see TOKEN_LEN).
+        assert!(check_template(&ok, 8, "api.example").is_err());
+        let full = "POST /v1/messages HTTP/1.1\r\nHost: api.example\r\nContent-Length: {body_len}\r\nAuthorization: Bearer {token}\r\nX-Later: 1\r\n\r\n";
+        let (hidden, trailer) = split_template(full).unwrap();
+        assert_eq!(trailer, b"X-Later: 1\r\n\r\n");
+        let real = fill_template(&hidden, TOKEN_LEN, 5).unwrap();
+        assert_eq!(real.token.len(), 112);
+        check_template(&real, TOKEN_LEN, "api.example").unwrap();
+        assert!(check_template(&real, TOKEN_LEN, "other.example").is_err());
+        // A shorter credential in the same span would leave room to smuggle a
+        // header, which is why it is refused.
+        let smuggled = b"\r\nX: value";
+        assert!(112 - 97 >= smuggled.len());
+        assert!(check_template(&real, 97, "api.example").is_err());
+
+        // The token must be the whole bearer value.
+        let bad = header(
+            "POST / HTTP/1.1\r\nHost: api.example\r\nAuthorization: Bearer {token}extra\r\n\r\n",
+        );
+        assert!(check_template(&bad, 8, "api.example").is_err());
+        // Not in another header.
+        let bad = header("POST / HTTP/1.1\r\nHost: api.example\r\nX-Key: {token}\r\n\r\n");
+        assert!(check_template(&bad, 8, "api.example").is_err());
+        // Not on the request line, and not right after it either (the line
+        // before Authorization is padded).
+        assert!(fill_template("POST /{token} HTTP/1.1\r\nHost: a\r\n\r\n", 8, 0).is_err());
+        assert!(fill_template("POST / HTTP/1.1\r\nAuthorization: Bearer {token}\r\nHost: a\r\n\r\n", 8, 0).is_err());
+        // Duplicate Host is refused.
+        let dup = header("POST / HTTP/1.1\r\nHost: a\r\nHost: api.example\r\nAuthorization: Bearer {token}\r\n\r\n");
+        assert!(check_template(&dup, 8, "api.example").is_err());
+    }
+
+    // The pool cannot read the body, so the template must say how long it is,
+    // within the limit, and may not repeat a header.
+    #[test]
+    fn template_policy_bounds_the_request() {
+        let real = |t: &str, body: usize| fill_template(&split_template(t).unwrap().0, TOKEN_LEN, body).unwrap();
+        let base = "POST / HTTP/1.1\r\nHost: api.example\r\nContent-Length: {body_len}\r\nAuthorization: Bearer {token}\r\n\r\n";
+        check_template(&real(base, MAX_BODY_LEN), TOKEN_LEN, "api.example").unwrap();
+        assert!(check_template(&real(base, MAX_BODY_LEN + 1), TOKEN_LEN, "api.example").is_err());
+        let no_length = real("POST / HTTP/1.1\r\nHost: api.example\r\nX: y\r\nAuthorization: Bearer {token}\r\n\r\n", 0);
+        assert!(check_template(&no_length, TOKEN_LEN, "api.example").is_err());
+        let twice = real(
+            "POST / HTTP/1.1\r\nHost: api.example\r\nContent-Length: {body_len}\r\nX-A: 1\r\nx-a: 2\r\nAuthorization: Bearer {token}\r\n\r\n",
+            0,
+        );
+        assert!(check_template(&twice, TOKEN_LEN, "api.example").is_err());
+    }
+
+    #[test]
+    fn dechunk_survives_hostile_sizes() {
+        assert_eq!(dechunk(b"3\r\nabc\r\n0\r\n\r\n"), b"abc");
+        // A size that would overflow `size + 2` is returned as-is, not panicked on.
+        let hostile = b"ffffffffffffffff\r\nabc\r\n";
+        assert_eq!(dechunk(hostile), hostile.to_vec());
+        let short = b"10\r\nabc\r\n";
+        assert_eq!(dechunk(short), short.to_vec());
+    }
+}
diff --git a/crates/lembas-mpc/src/main.rs b/crates/lembas-mpc/src/main.rs
new file mode 100644
index 0000000..f4cdd99
--- /dev/null
+++ b/crates/lembas-mpc/src/main.rs
@@ -0,0 +1,311 @@
+//! In-process demo: pool, borrower and tlsn's echo server in one process,
+//! with checks that the token never reaches the borrower.
+
+use std::{
+    pin::Pin,
+    sync::{
+        Arc,
+        atomic::{AtomicUsize, Ordering},
+    },
+    task::{Context as TaskContext, Poll},
+    time::Instant,
+};
+
+use anyhow::{Context as _, Result, bail, ensure};
+use clap::Parser;
+use lembas_mpc::{
+    TOKEN_LEN, Tamper, dechunk, fixture_roots, link,
+    record::{APPLICATION_DATA, LocalRecordLayer},
+    splice::{run_borrower, run_pool},
+};
+use rand::RngExt;
+use tls_server_fixture::SERVER_DOMAIN;
+use tokio::io::{AsyncRead, AsyncWrite, DuplexStream, ReadBuf};
+use tokio_util::compat::TokioAsyncReadCompatExt;
+
+/// The pool's secret. The borrower must never learn it.
+const TOKEN: &str = "sk-ant-api03-THIS-IS-THE-POOLS-SECRET-TOKEN-0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-A";
+
+const TEMPLATE: &str = "POST /echo HTTP/1.1\r\nHost: test-server.io\r\n\
+    Content-Length: {body_len}\r\nAuthorization: Bearer {token}\r\n\
+    Connection: close\r\nContent-Type: application/json\r\n\r\n";
+
+#[derive(Parser, Debug)]
+struct Args {
+    /// Size of the request body in bytes. The test server echoes it.
+    #[arg(long, default_value_t = 32 * 1024)]
+    body: usize,
+    /// Misbehave as the pool: change a header byte outside the token span.
+    /// The server must reject the record, since the tag binds the pool to
+    /// the borrower's text.
+    #[arg(long)]
+    evil_rewrite: bool,
+    /// Misbehave as the pool: connect the borrower to a server other than the
+    /// one it expects. The borrower must refuse during the handshake.
+    #[arg(long)]
+    evil_server: bool,
+}
+
+#[tokio::main]
+async fn main() -> Result<()> {
+    tracing_subscriber::fmt()
+        .with_env_filter(tracing_subscriber::EnvFilter::from_default_env())
+        .with_writer(std::io::stderr)
+        .init();
+
+    let args = Args::parse();
+
+    // The server.
+    let (server_client_sock, server_sock) = tokio::io::duplex(1 << 20);
+    let server = tokio::spawn(tls_server_fixture::bind_test_server_hyper(
+        server_sock.compat(),
+    ));
+
+    // The pool↔borrower link, with byte counters on the pool's end.
+    let (pool_sock, borrower_sock) = tokio::io::duplex(1 << 23);
+    let counters = LinkCounters::default();
+    let pool_sock = Counted::new(pool_sock, counters.clone());
+
+    let pool_link = link(pool_sock.compat())?;
+    let borrower_link = link(borrower_sock.compat())?;
+    let pool_driver = tokio::spawn(pool_link.driver);
+    let borrower_driver = tokio::spawn(borrower_link.driver);
+
+    let body: Vec<u8> = {
+        let mut rng = rand::rng();
+        let mut b = Vec::with_capacity(args.body);
+        while b.len() < args.body {
+            b.extend_from_slice(format!("{{\"n\":{}}},", rng.random::<u32>()).as_bytes());
+        }
+        b.truncate(args.body);
+        b
+    };
+
+    let token = TOKEN.to_string();
+    let tamper: Tamper = args
+        .evil_rewrite
+        .then(|| Box::new(|h: &mut Vec<u8>| h[0] = b'G') as Box<dyn FnOnce(&mut Vec<u8>) + Send>);
+    let expected_server = if args.evil_server {
+        "api.anthropic.com"
+    } else {
+        SERVER_DOMAIN
+    };
+
+    let started = Instant::now();
+    let outcome = tokio::try_join!(
+        run_pool(
+            pool_link.mpc,
+            pool_link.up,
+            pool_link.down,
+            server_client_sock,
+            SERVER_DOMAIN,
+            &token,
+            tamper,
+        ),
+        run_borrower(
+            borrower_link.mpc,
+            borrower_link.up,
+            borrower_link.down,
+            TEMPLATE,
+            body.clone(),
+            fixture_roots()?,
+            expected_server,
+            TOKEN_LEN,
+            Box::new(tokio::io::sink()),
+        ),
+    );
+    let total = started.elapsed();
+
+    if args.evil_rewrite || args.evil_server {
+        let err = match outcome {
+            Ok(_) => bail!("the borrower accepted a misbehaving pool"),
+            Err(err) => err,
+        };
+        let expected = if args.evil_rewrite {
+            // The server fails the record's tag and sends a fatal alert.
+            "alert"
+        } else {
+            "certificate"
+        };
+        ensure!(
+            format!("{err:#}").to_ascii_lowercase().contains(expected),
+            "unexpected failure: {err:#}"
+        );
+        println!();
+        println!("misbehaving pool rejected as expected: {err:#}");
+        return Ok(());
+    }
+    let (pool_report, borrower_report) = outcome?;
+
+    drop(pool_link.session);
+    drop(borrower_link.session);
+    let _ = pool_link.close.send(());
+    let _ = borrower_link.close.send(());
+    pool_driver.await??;
+    borrower_driver.await??;
+    match server.await? {
+        Ok(()) => {}
+        Err(e) => println!("test server ended with an error: {e}"),
+    }
+
+    // Checks.
+    let response = String::from_utf8_lossy(&borrower_report.response);
+    ensure!(
+        response.starts_with("HTTP/1.1 200 OK"),
+        "unexpected response: {}",
+        &response[..response.len().min(200)]
+    );
+    let body_pos = response
+        .find("\r\n\r\n")
+        .context("response has no header terminator")?
+        + 4;
+    let echoed = dechunk(&borrower_report.response[body_pos..]);
+    ensure!(
+        echoed == body,
+        "server did not echo the body: got {} bytes, sent {} (response {} bytes)",
+        echoed.len(),
+        body.len(),
+        borrower_report.response.len()
+    );
+
+    // What went over the link to the borrower must contain neither the token
+    // nor the token record's ciphertext (mux framing could split a match, so
+    // look for 16-byte windows of the record rather than the whole record).
+    let sent = SENT_TO_BORROWER.lock().unwrap();
+    ensure!(
+        !contains(&sent, TOKEN.as_bytes()),
+        "the token went to the borrower in the clear"
+    );
+    let record = &pool_report.record;
+    ensure!(record.len() > 5 + 8 + 16, "token record too short");
+    let ciphertext = &record[5 + 8..record.len() - 16];
+    for window in ciphertext.chunks(16).filter(|w| w.len() == 16) {
+        ensure!(
+            !contains(&sent, window),
+            "part of the token record's ciphertext went to the borrower"
+        );
+    }
+    drop(sent);
+
+    // Diagnostic only possible because both parties run in this process: the
+    // token record the pool sent must be what the borrower's keys produce
+    // from the borrower's template with the token in place.
+    {
+        let mut reference = LocalRecordLayer::new(&borrower_report.keys, borrower_report.splice_seq, 0);
+        let mut expected_headers = borrower_report.header.template.clone();
+        let span = &mut expected_headers[borrower_report.header.token.clone()];
+        span.fill(b' ');
+        span[..TOKEN.len()].copy_from_slice(TOKEN.as_bytes());
+        ensure!(expected_headers == pool_report.headers);
+        let expected = reference
+            .encrypt(APPLICATION_DATA, &expected_headers)
+            .context("reference encryption")?;
+        ensure!(
+            expected == pool_report.record,
+            "the token record differs from what the traffic keys produce"
+        );
+    }
+
+    println!();
+    println!("borrowed request OK");
+    println!("  protocol:              spliced record (borrower owns the session; zero-knowledge keystream)");
+    println!("  body:                  {} bytes, echoed back", body.len());
+    println!(
+        "  token record:          {} bytes plaintext, seq {}; span hidden from the borrower, rest bound to its text",
+        pool_report.headers.len(),
+        borrower_report.splice_seq
+    );
+    println!("  server identity:       verified by the borrower");
+    println!();
+    println!("timing (both parties on this machine)");
+    println!("  preprocessing:         {:>8.0?}  (overlapped with the handshake)", pool_report.preprocess);
+    println!("  handshake:             {:>8.0?}", pool_report.handshake);
+    println!("  token record:          {:>8.0?}", pool_report.splice);
+    println!(
+        "  body sent → first response byte: {:>5.0?}",
+        borrower_report.first_byte
+    );
+    println!("  total:                 {:>8.0?}", total);
+    println!();
+    println!("pool↔borrower link");
+    println!(
+        "  pool → borrower:       {:>8} KB",
+        counters.sent.load(Ordering::Relaxed) / 1024
+    );
+    println!(
+        "  borrower → pool:       {:>8} KB",
+        counters.received.load(Ordering::Relaxed) / 1024
+    );
+
+    Ok(())
+}
+
+#[derive(Default, Clone)]
+struct LinkCounters {
+    /// Bytes the pool sent to the borrower.
+    sent: Arc<AtomicUsize>,
+    /// Bytes the pool received from the borrower.
+    received: Arc<AtomicUsize>,
+}
+
+/// Counts bytes and records everything the pool sends to the borrower, so the
+/// program can check the token is not among it.
+struct Counted {
+    inner: DuplexStream,
+    counters: LinkCounters,
+}
+
+impl Counted {
+    fn new(inner: DuplexStream, counters: LinkCounters) -> Self {
+        Self { inner, counters }
+    }
+}
+
+impl AsyncRead for Counted {
+    fn poll_read(
+        mut self: Pin<&mut Self>,
+        cx: &mut TaskContext<'_>,
+        buf: &mut ReadBuf<'_>,
+    ) -> Poll<std::io::Result<()>> {
+        let before = buf.filled().len();
+        let res = Pin::new(&mut self.inner).poll_read(cx, buf);
+        if let Poll::Ready(Ok(())) = &res {
+            let n = buf.filled().len() - before;
+            self.counters.received.fetch_add(n, Ordering::Relaxed);
+        }
+        res
+    }
+}
+
+impl AsyncWrite for Counted {
+    fn poll_write(
+        mut self: Pin<&mut Self>,
+        cx: &mut TaskContext<'_>,
+        data: &[u8],
+    ) -> Poll<std::io::Result<usize>> {
+        let res = Pin::new(&mut self.inner).poll_write(cx, data);
+        if let Poll::Ready(Ok(n)) = &res {
+            self.counters.sent.fetch_add(*n, Ordering::Relaxed);
+            SENT_TO_BORROWER
+                .lock()
+                .unwrap()
+                .extend_from_slice(&data[..*n]);
+        }
+        res
+    }
+
+    fn poll_flush(mut self: Pin<&mut Self>, cx: &mut TaskContext<'_>) -> Poll<std::io::Result<()>> {
+        Pin::new(&mut self.inner).poll_flush(cx)
+    }
+
+    fn poll_shutdown(mut self: Pin<&mut Self>, cx: &mut TaskContext<'_>) -> Poll<std::io::Result<()>> {
+        Pin::new(&mut self.inner).poll_shutdown(cx)
+    }
+}
+
+/// Everything the pool sent to the borrower, for the token check.
+static SENT_TO_BORROWER: std::sync::Mutex<Vec<u8>> = std::sync::Mutex::new(Vec::new());
+
+fn contains(haystack: &[u8], needle: &[u8]) -> bool {
+    !needle.is_empty() && haystack.windows(needle.len()).any(|w| w == needle)
+}
diff --git a/crates/lembas-mpc/src/record.rs b/crates/lembas-mpc/src/record.rs
new file mode 100644
index 0000000..d816b77
--- /dev/null
+++ b/crates/lembas-mpc/src/record.rs
@@ -0,0 +1,213 @@
+//! TLS 1.2 AES-128-GCM records with keys this side holds: what the borrower
+//! runs after taking the keys out of rustls, continuing from the sequence
+//! numbers rustls reached (plus one on the client side, for the pool's
+//! record).
+
+use aes_gcm::{Aes128Gcm, NewAead, aead::AeadInPlace};
+use anyhow::{Result, bail, ensure};
+
+/// Largest plaintext a single TLS record may carry.
+pub const MAX_RECORD_PLAINTEXT: usize = 1 << 14;
+
+/// Record content types.
+pub const CHANGE_CIPHER_SPEC: u8 = 0x14;
+pub const ALERT: u8 = 0x15;
+pub const HANDSHAKE: u8 = 0x16;
+pub const APPLICATION_DATA: u8 = 0x17;
+
+/// The `close_notify` alert: warning level, description 0.
+pub const CLOSE_NOTIFY: [u8; 2] = [1, 0];
+
+const EXPLICIT_NONCE_LEN: usize = 8;
+const TAG_LEN: usize = 16;
+
+/// The TLS 1.2 traffic keys.
+#[derive(Clone)]
+pub struct TrafficKeys {
+    /// Client write key.
+    pub client_write_key: [u8; 16],
+    /// Client write IV (implicit nonce part).
+    pub client_write_iv: [u8; 4],
+    /// Server write key.
+    pub server_write_key: [u8; 16],
+    /// Server write IV (implicit nonce part).
+    pub server_write_iv: [u8; 4],
+}
+
+impl std::fmt::Debug for TrafficKeys {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("TrafficKeys").finish_non_exhaustive()
+    }
+}
+
+/// The additional data AES-GCM authenticates for a TLS 1.2 record.
+pub fn tls12_aad(seq: u64, typ: u8, len: usize) -> [u8; 13] {
+    let mut aad = [0u8; 13];
+    aad[..8].copy_from_slice(&seq.to_be_bytes());
+    aad[8] = typ;
+    aad[9] = 0x03;
+    aad[10] = 0x03;
+    aad[11..].copy_from_slice(&(len as u16).to_be_bytes());
+    aad
+}
+
+/// Both directions of the record layer.
+pub struct LocalRecordLayer {
+    keys: TrafficKeys,
+    writer: LocalRecordWriter,
+    reader: LocalRecordReader,
+}
+
+impl LocalRecordLayer {
+    /// Creates a record layer continuing from the given sequence numbers.
+    pub fn new(keys: &TrafficKeys, write_seq: u64, read_seq: u64) -> Self {
+        Self {
+            keys: keys.clone(),
+            writer: LocalRecordWriter::new(keys, write_seq),
+            reader: LocalRecordReader::new(keys, read_seq),
+        }
+    }
+
+    pub fn keys(&self) -> &TrafficKeys {
+        &self.keys
+    }
+
+    /// Encrypts one record and returns it encoded, ready for the wire.
+    pub fn encrypt(&mut self, typ: u8, plaintext: &[u8]) -> Result<Vec<u8>> {
+        self.writer.encrypt(typ, plaintext)
+    }
+
+    /// Decrypts one encoded record received from the server.
+    pub fn decrypt(&mut self, record: &[u8]) -> Result<(u8, Vec<u8>)> {
+        self.reader.decrypt(record)
+    }
+
+    /// Splits into the sending and the receiving half.
+    pub fn split(self) -> (LocalRecordWriter, LocalRecordReader) {
+        (self.writer, self.reader)
+    }
+}
+
+/// Encrypts records to the server under the client write key.
+pub struct LocalRecordWriter {
+    cipher: Aes128Gcm,
+    iv: [u8; 4],
+    seq: u64,
+}
+
+impl LocalRecordWriter {
+    fn new(keys: &TrafficKeys, seq: u64) -> Self {
+        Self {
+            cipher: Aes128Gcm::new((&keys.client_write_key).into()),
+            iv: keys.client_write_iv,
+            seq,
+        }
+    }
+
+    /// Encrypts one record and returns it encoded, ready for the wire. The
+    /// explicit nonce is the sequence number, as rustls does it.
+    pub fn encrypt(&mut self, typ: u8, plaintext: &[u8]) -> Result<Vec<u8>> {
+        ensure!(
+            plaintext.len() <= MAX_RECORD_PLAINTEXT,
+            "record plaintext too long: {} > {MAX_RECORD_PLAINTEXT}",
+            plaintext.len()
+        );
+        let seq = self.seq;
+        self.seq += 1;
+
+        let explicit_nonce = seq.to_be_bytes();
+        let mut nonce = [0u8; 12];
+        nonce[..4].copy_from_slice(&self.iv);
+        nonce[4..].copy_from_slice(&explicit_nonce);
+        let aad = tls12_aad(seq, typ, plaintext.len());
+
+        let mut body = plaintext.to_vec();
+        let tag = self
+            .cipher
+            .encrypt_in_place_detached((&nonce).into(), &aad, &mut body)
+            .map_err(|_| anyhow::anyhow!("encryption failed"))?;
+
+        let len = EXPLICIT_NONCE_LEN + body.len() + TAG_LEN;
+        let mut record = Vec::with_capacity(5 + len);
+        record.extend_from_slice(&[typ, 0x03, 0x03]);
+        record.extend_from_slice(&(len as u16).to_be_bytes());
+        record.extend_from_slice(&explicit_nonce);
+        record.extend_from_slice(&body);
+        record.extend_from_slice(&tag);
+        Ok(record)
+    }
+}
+
+/// Decrypts records from the server under the server write key.
+pub struct LocalRecordReader {
+    cipher: Aes128Gcm,
+    iv: [u8; 4],
+    seq: u64,
+}
+
+impl LocalRecordReader {
+    fn new(keys: &TrafficKeys, seq: u64) -> Self {
+        Self {
+            cipher: Aes128Gcm::new((&keys.server_write_key).into()),
+            iv: keys.server_write_iv,
+            seq,
+        }
+    }
+
+    /// Decrypts one whole encoded record (5-byte header included).
+    pub fn decrypt(&mut self, record: &[u8]) -> Result<(u8, Vec<u8>)> {
+        ensure!(record.len() >= 5, "record too short");
+        let typ = record[0];
+        ensure!(record[1] == 0x03, "not a TLS record");
+        let len = u16::from_be_bytes([record[3], record[4]]) as usize;
+        ensure!(record.len() == 5 + len, "record length mismatch");
+        let payload = &record[5..];
+        if payload.len() < EXPLICIT_NONCE_LEN + TAG_LEN {
+            bail!("ciphertext record is too short");
+        }
+        let (explicit_nonce, rest) = payload.split_at(EXPLICIT_NONCE_LEN);
+        let (ciphertext, tag) = rest.split_at(rest.len() - TAG_LEN);
+
+        let seq = self.seq;
+        self.seq += 1;
+
+        let mut nonce = [0u8; 12];
+        nonce[..4].copy_from_slice(&self.iv);
+        nonce[4..].copy_from_slice(explicit_nonce);
+        let aad = tls12_aad(seq, typ, ciphertext.len());
+
+        let mut plaintext = ciphertext.to_vec();
+        self.cipher
+            .decrypt_in_place_detached((&nonce).into(), &aad, &mut plaintext, tag.into())
+            .map_err(|_| anyhow::anyhow!("tag verification failed"))?;
+        Ok((typ, plaintext))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn round_trip_through_both_halves() {
+        let keys = TrafficKeys {
+            client_write_key: [1; 16],
+            client_write_iv: [2; 4],
+            server_write_key: [1; 16],
+            server_write_iv: [2; 4],
+        };
+        // The server's reader is the client's writer with the keys swapped,
+        // so with identical keys a writer at seq n decrypts with a reader at n.
+        let mut writer = LocalRecordLayer::new(&keys, 7, 0);
+        let mut reader = LocalRecordLayer::new(&keys, 0, 7);
+        let record = writer.encrypt(APPLICATION_DATA, b"hello").unwrap();
+        assert_eq!(record[0], APPLICATION_DATA);
+        assert_eq!(record.len(), 5 + 8 + 5 + 16);
+        assert_eq!(reader.decrypt(&record).unwrap(), (APPLICATION_DATA, b"hello".to_vec()));
+        // Wrong sequence number: the tag fails.
+        let record = writer.encrypt(ALERT, &CLOSE_NOTIFY).unwrap();
+        let mut skipped = LocalRecordLayer::new(&keys, 0, 9);
+        assert!(skipped.decrypt(&record).is_err());
+        assert_eq!(reader.decrypt(&record).unwrap(), (ALERT, CLOSE_NOTIFY.to_vec()));
+    }
+}
diff --git a/crates/lembas-mpc/src/splice.rs b/crates/lembas-mpc/src/splice.rs
new file mode 100644
index 0000000..7d31aa6
--- /dev/null
+++ b/crates/lembas-mpc/src/splice.rs
@@ -0,0 +1,1148 @@
+//! The spliced token record: the borrower owns the TLS session, the pool
+//! inserts one record.
+//!
+//! The borrower runs an ordinary TLS 1.2 client (rustls) over a byte relay
+//! through the pool, verifies the server's certificate itself and holds the
+//! traffic keys alone from the start. The pool opens the TCP connection, so it
+//! decides which server the token goes to, and it writes exactly one record:
+//! the request line, `Host`, `Content-Length` and the `Authorization` line.
+//! For that record it needs keystream and a tag.
+//!
+//! - Keystream: AES on the borrower's client key, proven in zero knowledge
+//!   (mpz's QuickSilver VM). The borrower is the prover, so its key stays
+//!   private against a malicious pool; the pool is the verifier and receives
+//!   the keystream with a soundness guarantee against a borrower that would
+//!   try to pass off a keystream of its choosing (say zeros, which would put
+//!   the token on the pool's uplink in the clear). Nothing is garbled: the
+//!   pool has no private input, so a proof is all it needs.
+//! - Tag: the borrower knows `H` and `E_K(J0)` and computes the GHASH terms
+//!   for every block it knows; the token span's blocks go through one
+//!   multiplicative-to-additive conversion each, with the pool's ciphertext
+//!   block as its input. The pool learns only the finished tag.
+//!
+//! The pool refuses to splice unless the first application-data record on the
+//! connection is its own, so the token cannot become the body or a header
+//! continuation of a request the borrower wrote. Then the borrower continues
+//! with its own records, sequence number +1, and the pool relays bytes it can
+//! neither read nor forge.
+//!
+//! The link carries three channels, opened in the same order by both sides:
+//! `mpc` for the two-party computation, `up` for everything the borrower
+//! sends (its header, then [`Frame`]s), `down` for everything the pool sends
+//! (its [`Hello`], then [`Frame`]s).
+
+use std::{
+    sync::Arc,
+    time::{Duration, Instant},
+};
+
+use aes::cipher::{BlockEncrypt, KeyInit, generic_array::GenericArray};
+use anyhow::{Context as _, Result, bail, ensure};
+use mpz_circuits::{AES128_KS, AES128_POST_KS};
+use mpz_common::{Context, Flush, future::Output as _};
+use mpz_core::{Block, bitvec::BitVec};
+use mpz_fields::{Field, gf2_128::Gf2_128};
+use mpz_garble_core::Delta;
+use mpz_memory_core::DecodeFutureTyped;
+use mpz_ole::{Receiver as OleReceiver, Sender as OleSender};
+use mpz_ot::{
+    chou_orlandi as co, ferret, kos,
+    rcot::shared::{SharedRCOTReceiver, SharedRCOTSender},
+    rot::{
+        any::{AnyReceiver, AnySender},
+        randomize::{RandomizeRCOTReceiver, RandomizeRCOTSender},
+    },
+};
