+//! The borrower's local face: HTTP/1.1 response framing, and a local proxy
+//! that turns plain HTTP requests from a parent process (the lembas agent)
+//! into borrowed requests on a session.
+
+use std::sync::{
+    Arc,
+    atomic::{AtomicU64, Ordering},
+};
+
+use anyhow::{Context as _, Result, bail, ensure};
+use tokio::{
+    io::{AsyncBufReadExt, AsyncReadExt, AsyncWrite, AsyncWriteExt, BufReader},
+    net::{TcpListener, TcpStream},
+};
+use tracing::{debug, info, warn};
+
+use crate::{MAX_BODY_LEN, session::{Refused, Session}};
+
+/// Largest request head the local proxy accepts.
+const MAX_HEAD: usize = 64 << 10;
+
+/// Headers the proxy never forwards into the template: the pool's record
+/// supplies the first three, the rest are hop-by-hop or would change the
+/// framing the pool counts on.
+const DROPPED: &[&str] = &[
+    "host",
+    "content-length",
+    "authorization",
+    "x-api-key",
+    "connection",
+    "transfer-encoding",
+    "accept-encoding",
+    "expect",
+    "keep-alive",
+    "proxy-connection",
+    "upgrade",
+];
+
+// ---------------------------------------------------------------------------
+// Response framing
+
+#[derive(Debug)]
+enum Body {
+    Length(usize),
+    ChunkSize(Vec<u8>),
+    ChunkData(usize),
+    ChunkEnd(usize),
+    Trailer(Vec<u8>),
+    UntilClose,
+    Done,
+}
+
+/// Follows an HTTP/1.1 response byte by byte to know where it ends, so a
+/// connection can be reused.
+#[derive(Debug, Default)]
+pub struct ResponseFramer {
+    head: Vec<u8>,
+    status: Option<u16>,
+    keep_alive: bool,
+    body: Option<Body>,
+}
+
+impl ResponseFramer {
+    /// Consumes bytes of the response; returns how many belonged to it.
+    pub fn feed(&mut self, mut bytes: &[u8]) -> Result<usize> {
+        let total = bytes.len();
+        while !bytes.is_empty() {
+            let Some(body) = self.body.as_mut() else {
+                // Still in the head.
+                let take = bytes.len().min(MAX_HEAD - self.head.len());
+                ensure!(take > 0, "response head longer than {MAX_HEAD} bytes");
+                self.head.extend_from_slice(&bytes[..take]);
+                if let Some(end) = self.head.windows(4).position(|w| w == b"\r\n\r\n") {
+                    let extra = self.head.len() - (end + 4);
+                    self.head.truncate(end + 4);
+                    self.parse_head()?;
+                    // Replay what came after the head.
+                    bytes = &bytes[take - extra..];
+                } else {
+                    bytes = &bytes[take..];
+                }
+                continue;
+            };
+            match body {
+                Body::Done => break,
+                Body::UntilClose => {
+                    bytes = &[];
+                }
+                Body::Length(remaining) => {
+                    let n = bytes.len().min(*remaining);
+                    *remaining -= n;
+                    bytes = &bytes[n..];
+                    if *remaining == 0 {
+                        self.body = Some(Body::Done);
+                    }
+                }
+                Body::ChunkSize(line) => {
+                    let (consumed, complete) = take_line(line, bytes);
+                    bytes = &bytes[consumed..];
+                    if complete {
+                        let text = std::str::from_utf8(line).context("chunk size")?;
+                        let size = text.split(';').next().unwrap_or("").trim();
+                        if size.is_empty() {
+                            // A stray CRLF between chunks; keep looking.
+                            line.clear();
+                            continue;
+                        }
+                        let size = usize::from_str_radix(size, 16).context("chunk size")?;
+                        self.body = Some(if size == 0 {
+                            Body::Trailer(Vec::new())
+                        } else {
+                            Body::ChunkData(size)
+                        });
+                    }
+                }
+                Body::ChunkData(remaining) => {
+                    let n = bytes.len().min(*remaining);
+                    *remaining -= n;
+                    bytes = &bytes[n..];
+                    if *remaining == 0 {
+                        self.body = Some(Body::ChunkEnd(2));
+                    }
+                }
+                Body::ChunkEnd(remaining) => {
+                    let n = bytes.len().min(*remaining);
+                    *remaining -= n;
+                    bytes = &bytes[n..];
+                    if *remaining == 0 {
+                        self.body = Some(Body::ChunkSize(Vec::new()));
+                    }
+                }
+                Body::Trailer(line) => {
+                    let (consumed, complete) = take_line(line, bytes);
+                    bytes = &bytes[consumed..];
+                    if complete {
+                        if line.is_empty() {
+                            self.body = Some(Body::Done);
+                        } else {
+                            line.clear();
+                        }
+                    }
+                }
+            }
+        }
+        Ok(total - bytes.len())
+    }
+
+    fn parse_head(&mut self) -> Result<()> {
+        let text = std::str::from_utf8(&self.head).context("response head is not UTF-8")?;
+        let mut lines = text.split("\r\n");
+        let status_line = lines.next().unwrap_or("");
+        let status: u16 = status_line
+            .split(' ')
+            .nth(1)
+            .and_then(|s| s.parse().ok())
+            .context("malformed status line")?;
+        self.status = Some(status);
+        let mut length = None;
+        let mut chunked = false;
+        let mut close = false;
+        for line in lines {
+            let Some((name, value)) = line.split_once(':') else {
+                continue;
+            };
+            let name = name.trim().to_ascii_lowercase();
+            let value = value.trim();
+            match name.as_str() {
+                "content-length" => length = Some(value.parse::<usize>().context("Content-Length")?),
+                "transfer-encoding" => chunked = value.to_ascii_lowercase().contains("chunked"),
+                "connection" => close = value.to_ascii_lowercase().contains("close"),
+                _ => {}
+            }
+        }
+        self.keep_alive = !close;
+        self.body = Some(if (100..200).contains(&status) || status == 204 || status == 304 {
+            Body::Done
+        } else if chunked {
+            Body::ChunkSize(Vec::new())
+        } else if let Some(n) = length {
+            if n == 0 { Body::Done } else { Body::Length(n) }
+        } else {
+            self.keep_alive = false;
+            Body::UntilClose
+        });
+        Ok(())
+    }
+
+    /// True once the whole response has been fed.
+    pub fn complete(&self) -> bool {
+        matches!(self.body, Some(Body::Done))
+    }
+
+    /// True if the server closing now ends the response properly.
+    pub fn complete_at_close(&self) -> bool {
+        matches!(self.body, Some(Body::Done) | Some(Body::UntilClose))
+    }
+
+    /// Whether the connection may carry another request afterwards.
+    pub fn keep_alive(&self) -> bool {
+        self.keep_alive && self.complete()
+    }
+
+    pub fn status(&self) -> Option<u16> {
+        self.status
+    }
+}
+
+/// Appends bytes to `line` up to and including a CRLF; returns how many were
+/// consumed and whether the line is complete (`line` then holds it without
+/// the CRLF).
+fn take_line(line: &mut Vec<u8>, bytes: &[u8]) -> (usize, bool) {
+    for (i, &b) in bytes.iter().enumerate() {
+        line.push(b);
+        if line.ends_with(b"\r\n") {
+            line.truncate(line.len() - 2);
+            return (i + 1, true);
+        }
+        if line.len() > 1024 {
+            // A chunk-size or trailer line this long is not HTTP; let the
+            // caller's parse fail on it.
+            return (i + 1, true);
+        }
+    }
+    (bytes.len(), false)
+}
+
+// ---------------------------------------------------------------------------
+// The local proxy
+
+/// Serves plain HTTP/1.1 clients on `listener`, each request becoming one
+/// borrowed request on `session`. One request per client connection: the
+/// response is relayed as the server sent it, with one header added
+/// (`x-lembas-request`, the pool's number for the request, so the client can
+/// report its outcome to the pool), and the connection is closed after it, so
+/// a client reading to the end of the stream needs no framing of its own.
+pub async fn serve_local(session: Arc<Session>, listener: TcpListener) -> Result<()> {
+    info!("proxy: listening on {}", listener.local_addr()?);
+    loop {
+        let (stream, peer) = listener.accept().await?;
+        stream.set_nodelay(true)?;
+        let session = session.clone();
+        tokio::spawn(async move {
+            if let Err(e) = serve_client(session, stream).await {
+                debug!("proxy: client {peer}: {e:#}");
+            }
+        });
+    }
+}
+
+async fn serve_client(session: Arc<Session>, stream: TcpStream) -> Result<()> {
+    let (rd, mut wr) = stream.into_split();
+    let mut rd = BufReader::new(rd);
+    let result = async {
+        // The head.
+        let mut head = Vec::new();
+        loop {
+            let n = rd.read_until(b'\n', &mut head).await?;
+            if n == 0 {
+                return Ok(());
+            }
+            ensure!(head.len() <= MAX_HEAD, "request head longer than {MAX_HEAD} bytes");
+            if head.ends_with(b"\r\n\r\n") {
+                break;
+            }
+        }
+        let (template, body_len) = match parse_request(&head) {
+            Ok(x) => x,
+            Err(e) => {
+                respond_error(&mut wr, 400, "bad_request", &format!("{e:#}")).await?;
+                return Ok(());
+            }
+        };
+        let mut body = vec![0u8; body_len];
+        rd.read_exact(&mut body).await.context("reading the request body")?;
+
+        let req = Arc::new(AtomicU64::new(0));
+        let mut out = HeaderInsert::new(&mut wr, req.clone());
+        let on_req = {
+            let req = req.clone();
+            move |n: u64| req.store(n, Ordering::Relaxed)
+        };
+        match session.request(&template, body, &mut out, on_req).await {
+            Ok(response) => {
+                debug!(
+                    req = response.req,
+                    status = ?response.status,
+                    bytes = response.bytes,
+                    reused = response.reused,
+                    "proxy: request done"
+                );
+            }
+            Err(e) => {
+                if out.started() {
+                    // The client has part of a response; nothing to add.
+                    warn!("proxy: request failed mid-response: {e:#}");
+                    return Err(e);
+                }
+                let (status, kind) = match e.downcast_ref::<Refused>() {
+                    Some(_) => (503, "refused"),
+                    None => (502, "failed"),
+                };
+                warn!("proxy: request failed: {e:#}");
+                respond_error(&mut wr, status, kind, &format!("{e:#}")).await?;
+            }
+        }
+        Ok::<(), anyhow::Error>(())
+    }
+    .await;
+    let _ = wr.shutdown().await;
+    result
+}
+
+/// Turns a request head into a template for the session: the pool's part
+/// (request line, Host, Content-Length, Authorization) first, then the
+/// client's other headers.
+fn parse_request(head: &[u8]) -> Result<(String, usize)> {
+    let text = std::str::from_utf8(head).context("request head is not UTF-8")?;
+    let mut lines = text.trim_end_matches("\r\n").split("\r\n");
+    let request_line = lines.next().unwrap_or("");
+    let mut parts = request_line.split(' ');
+    let method = parts.next().unwrap_or("");
+    let path = parts.next().unwrap_or("");
+    let version = parts.next().unwrap_or("");
+    ensure!(
+        !method.is_empty()
+            && method.bytes().all(|b| b.is_ascii_alphabetic())
+            && path.starts_with('/')
+            && version.starts_with("HTTP/1.")
+            && parts.next().is_none(),
+        "malformed request line"
+    );
+    let mut body_len = None;
+    let mut rest = String::new();
+    for line in lines {
+        let (name, value) = line.split_once(':').context("malformed header line")?;
+        let lname = name.trim().to_ascii_lowercase();
+        let value = value.trim();
+        ensure!(!value.contains(['\r', '\n']), "header value with a line break");
+        if lname == "content-length" {
+            body_len = Some(value.parse::<usize>().context("Content-Length")?);
+        }
+        if lname == "transfer-encoding" {
+            bail!("chunked requests are not supported; send Content-Length");
+        }
+        if DROPPED.contains(&lname.as_str()) {
+            continue;
+        }
+        rest.push_str(name.trim());
+        rest.push_str(": ");
+        rest.push_str(value);
+        rest.push_str("\r\n");
+    }
+    let body_len = body_len.context("Content-Length required")?;
+    ensure!(body_len <= MAX_BODY_LEN, "body of {body_len} bytes is over the limit");
+    rest.push_str("accept-encoding: identity\r\n");
+    let template = format!(
+        "{method} {path} HTTP/1.1\r\nHost: {{host}}\r\nContent-Length: {{body_len}}\r\nAuthorization: Bearer {{token}}\r\n{rest}\r\n"
+    );
+    Ok((template, body_len))
+}
+
+async fn respond_error<W: AsyncWrite + Unpin>(wr: &mut W, status: u16, kind: &str, message: &str) -> Result<()> {
+    let reason = match status {
+        400 => "Bad Request",
+        503 => "Service Unavailable",
+        _ => "Bad Gateway",
+    };
+    let body = serde_json::json!({
+        "type": "error",
+        "error": { "type": format!("lembas_{kind}"), "message": message },
+    })
+    .to_string();
+    let head = format!(
+        "HTTP/1.1 {status} {reason}\r\ncontent-type: application/json\r\ncontent-length: {}\r\nx-lembas-error: {kind}\r\n\r\n",
+        body.len()
+    );
+    wr.write_all(head.as_bytes()).await?;
+    wr.write_all(body.as_bytes()).await?;
+    wr.flush().await?;
+    Ok(())
+}
+
+/// Passes a response through, adding `x-lembas-request` to its head.
+struct HeaderInsert<'a, W> {
+    inner: &'a mut W,
+    req: Arc<AtomicU64>,
+    head: Vec<u8>,
+    in_head: bool,
+    started: bool,
+}
+
+impl<'a, W: AsyncWrite + Unpin> HeaderInsert<'a, W> {
+    fn new(inner: &'a mut W, req: Arc<AtomicU64>) -> Self {
+        Self {
+            inner,
+            req,
+            head: Vec::new(),
+            in_head: true,
+            started: false,
+        }
+    }
+
+    fn started(&self) -> bool {
+        self.started
+    }
+}
+
+impl<W: AsyncWrite + Unpin> AsyncWrite for HeaderInsert<'_, W> {
+    fn poll_write(
+        mut self: std::pin::Pin<&mut Self>,
+        cx: &mut std::task::Context<'_>,
+        data: &[u8],
+    ) -> std::task::Poll<std::io::Result<usize>> {
+        self.started = true;
+        if self.in_head {
+            self.head.extend_from_slice(data);
+            if let Some(end) = self.head.windows(4).position(|w| w == b"\r\n\r\n") {
+                let line = format!("x-lembas-request: {}\r\n", self.req.load(Ordering::Relaxed));
+                self.head.splice(end + 2..end + 2, line.into_bytes());
+                self.in_head = false;
+                // Hand the whole head (and whatever followed) to the inner
+                // writer in one go.
+                let pending = std::mem::take(&mut self.head);
+                let this = &mut *self;
+                let mut written = 0;
+                while written < pending.len() {
+                    match std::pin::Pin::new(&mut *this.inner).poll_write(cx, &pending[written..]) {
+                        std::task::Poll::Ready(Ok(n)) => written += n,
+                        std::task::Poll::Ready(Err(e)) => return std::task::Poll::Ready(Err(e)),
+                        std::task::Poll::Pending => {
+                            // Keep the rest for the next poll.
+                            this.head = pending[written..].to_vec();
+                            this.in_head = false;
+                            return std::task::Poll::Ready(Ok(data.len()));
+                        }
+                    }
+                }
+            } else if self.head.len() > MAX_HEAD {
+                return std::task::Poll::Ready(Err(std::io::Error::other("response head too long")));
+            }
+            return std::task::Poll::Ready(Ok(data.len()));
+        }
+        // Drain anything a Pending left behind, then the new data.
+        if !self.head.is_empty() {
+            let pending = std::mem::take(&mut self.head);
+            let this = &mut *self;
+            match std::pin::Pin::new(&mut *this.inner).poll_write(cx, &pending) {
+                std::task::Poll::Ready(Ok(n)) if n == pending.len() => {}
+                std::task::Poll::Ready(Ok(n)) => {
+                    this.head = pending[n..].to_vec();
+                    this.head.extend_from_slice(data);
+                    return std::task::Poll::Ready(Ok(data.len()));
+                }
+                std::task::Poll::Ready(Err(e)) => return std::task::Poll::Ready(Err(e)),
+                std::task::Poll::Pending => {
+                    this.head = pending;
+                    return std::task::Poll::Pending;
+                }
+            }
+        }
+        std::pin::Pin::new(&mut *self.inner).poll_write(cx, data)
+    }
+
+    fn poll_flush(
+        mut self: std::pin::Pin<&mut Self>,
+        cx: &mut std::task::Context<'_>,
+    ) -> std::task::Poll<std::io::Result<()>> {
+        if !self.in_head && !self.head.is_empty() {
+            let pending = std::mem::take(&mut self.head);
+            let this = &mut *self;
+            match std::pin::Pin::new(&mut *this.inner).poll_write(cx, &pending) {
+                std::task::Poll::Ready(Ok(n)) if n == pending.len() => {}
+                std::task::Poll::Ready(Ok(n)) => {
+                    this.head = pending[n..].to_vec();
+                    cx.waker().wake_by_ref();
+                    return std::task::Poll::Pending;
+                }
+                std::task::Poll::Ready(Err(e)) => return std::task::Poll::Ready(Err(e)),
+                std::task::Poll::Pending => {
+                    this.head = pending;
+                    return std::task::Poll::Pending;
+                }
+            }
+        }
+        std::pin::Pin::new(&mut *self.inner).poll_flush(cx)
+    }
+
+    fn poll_shutdown(
+        mut self: std::pin::Pin<&mut Self>,
+        cx: &mut std::task::Context<'_>,
+    ) -> std::task::Poll<std::io::Result<()>> {
+        std::pin::Pin::new(&mut *self.inner).poll_shutdown(cx)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn framer_follows_content_length_and_chunks() {
+        let mut f = ResponseFramer::default();
+        let resp = b"HTTP/1.1 200 OK\r\ncontent-length: 5\r\n\r\nhelloEXTRA";
+        assert_eq!(f.feed(&resp[..10]).unwrap(), 10);
+        assert!(!f.complete());
+        assert_eq!(f.feed(&resp[10..]).unwrap(), resp.len() - 10 - 5);
+        assert!(f.complete() && f.keep_alive());
+        assert_eq!(f.status(), Some(200));
+
+        let mut f = ResponseFramer::default();
+        let resp = b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n3\r\nabc\r\n0\r\n\r\n";
+        for b in resp.iter() {
+            assert_eq!(f.feed(std::slice::from_ref(b)).unwrap(), 1);
+        }
+        assert!(f.complete());
+        assert!(!f.keep_alive());
+
+        let mut f = ResponseFramer::default();
+        f.feed(b"HTTP/1.1 200 OK\r\n\r\nstream").unwrap();
+        assert!(!f.complete() && f.complete_at_close() && !f.keep_alive());
+
+        let mut f = ResponseFramer::default();
+        f.feed(b"HTTP/1.1 204 No Content\r\n\r\n").unwrap();
+        assert!(f.complete() && f.keep_alive());
+    }
+
+    #[test]
+    fn request_head_becomes_a_template() {
+        let head = b"POST /v1/messages HTTP/1.1\r\nHost: x\r\nContent-Length: 12\r\nAuthorization: Bearer nope\r\nanthropic-version: 2023-06-01\r\nConnection: keep-alive\r\n\r\n";
+        let (template, len) = parse_request(head).unwrap();
+        assert_eq!(len, 12);
+        assert_eq!(
+            template,
+            "POST /v1/messages HTTP/1.1\r\nHost: {host}\r\nContent-Length: {body_len}\r\nAuthorization: Bearer {token}\r\nanthropic-version: 2023-06-01\r\naccept-encoding: identity\r\n\r\n"
+        );
+        assert!(parse_request(b"GET / HTTP/1.1\r\n\r\n").is_err());
+        assert!(parse_request(b"POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n").is_err());
+    }
+}
diff --git a/crates/lembas-mpc/src/main.rs b/crates/lembas-mpc/src/main.rs
new file mode 100644
index 0000000..0ab4e30
--- /dev/null
+++ b/crates/lembas-mpc/src/main.rs
@@ -0,0 +1,349 @@
+//! In-process demo: pool, borrower and tlsn's echo server in one process,
+//! many requests over one session, with checks that the token never reaches
+//! the borrower.
+
+use std::{
+    pin::Pin,
+    sync::{
+        Arc,
+        atomic::{AtomicUsize, Ordering},
+    },
+    task::{Context as TaskContext, Poll},
+    time::Instant,
+};
+
+use anyhow::{Context as _, Result, bail, ensure};
+use clap::Parser;
+use lembas_mpc::{
+    TOKEN_LEN, dechunk, fixture_roots, link,
+    session::{Connector, Session, Tamper, fixed_token, run_pool},
+};
+use rand::RngExt;
+use tls_server_fixture::SERVER_DOMAIN;
+use tokio::io::{AsyncRead, AsyncWrite, DuplexStream, ReadBuf};
+use tokio_util::compat::TokioAsyncReadCompatExt;
+
+/// The pool's secret. The borrower must never learn it.
+const TOKEN: &str = "sk-ant-api03-THIS-IS-THE-POOLS-SECRET-TOKEN-0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-A";
+
+const TEMPLATE: &str = "POST /echo HTTP/1.1\r\nHost: {host}\r\n\
+    Content-Length: {body_len}\r\nAuthorization: Bearer {token}\r\n\
+    Content-Type: application/json\r\n\r\n";
+
+/// The same, asking the server to close afterwards: forces a new connection
+/// for the next request.
+const TEMPLATE_CLOSE: &str = "POST /echo HTTP/1.1\r\nHost: {host}\r\n\
+    Content-Length: {body_len}\r\nAuthorization: Bearer {token}\r\n\
+    Content-Type: application/json\r\nConnection: close\r\n\r\n";
+
+#[derive(Parser, Debug)]
+struct Args {
+    /// Requests to make over the one session.
+    #[arg(long, default_value_t = 6)]
+    requests: usize,
+    /// How many at a time.
+    #[arg(long, default_value_t = 3)]
+    concurrency: usize,
+    /// Size of each request body in bytes. The test server echoes it.
+    #[arg(long, default_value_t = 32 * 1024)]
+    body: usize,
+    /// Refuse to lend for the first N requests (nobody has capacity), then
+    /// lend; the borrower must report each refusal and the session go on.
+    #[arg(long, default_value_t = 0)]
+    refuse_first: usize,
+    /// Misbehave as the pool: change a header byte outside the token span.
+    /// The server must reject the record, since the tag binds the pool to
+    /// the borrower's text.
+    #[arg(long)]
+    evil_rewrite: bool,
+    /// Misbehave as the pool: connect the borrower to a server other than the
+    /// one it expects. The borrower must refuse during the handshake.
+    #[arg(long)]
+    evil_server: bool,
+}
+
+#[tokio::main]
+async fn main() -> Result<()> {
+    tracing_subscriber::fmt()
+        .with_env_filter(tracing_subscriber::EnvFilter::from_default_env())
+        .with_writer(std::io::stderr)
+        .init();
+
+    let args = Args::parse();
+
+    // The pool↔borrower link, with byte counters on the pool's end.
+    let (pool_sock, borrower_sock) = tokio::io::duplex(1 << 23);
+    let counters = LinkCounters::default();
+    let pool_sock = Counted::new(pool_sock, counters.clone());
+
+    let pool_link = link(pool_sock.compat())?;
+    let borrower_link = link(borrower_sock.compat())?;
+    let pool_driver = tokio::spawn(pool_link.driver);
+    let borrower_driver = tokio::spawn(borrower_link.driver);
+
+    // Every `Open` gets its own echo server on an in-memory pipe.
+    let connector: Connector<DuplexStream> = Arc::new(|| {
+        Box::pin(async {
+            let (client, server) = tokio::io::duplex(1 << 20);
+            tokio::spawn(async move {
+                if let Err(e) = tls_server_fixture::bind_test_server_hyper(server.compat()).await {
+                    tracing::debug!("test server: {e}");
+                }
+            });
+            Ok(client)
+        })
+    });
+
+    let tamper: Tamper = args
+        .evil_rewrite
+        .then(|| Arc::new(|h: &mut Vec<u8>| h[0] = b'G') as Arc<dyn Fn(&mut Vec<u8>) + Send + Sync>);
+    // The evil pool claims to lend for the name the borrower expects while
+    // connecting it to the test server; only the certificate check can tell.
+    let expected_server = if args.evil_server {
+        "api.anthropic.com"
+    } else {
+        SERVER_DOMAIN
+    };
+    let announced_server = expected_server;
+
+    let started = Instant::now();
+    let pool = run_pool(
+        pool_link.mpc,
+        pool_link.up,
+        pool_link.down,
+        connector,
+        announced_server,
+        refusing_first(args.refuse_first, fixed_token(TOKEN.to_string())),
+        None,
+        tamper,
+    );
+    let borrower = async {
+        let session = Arc::new(
+            Session::start(
+                borrower_link.mpc,
+                borrower_link.up,
+                borrower_link.down,
+                &fixture_roots()?,
+                expected_server,
+                TOKEN_LEN,
+            )
+            .await?,
+        );
+        let ready = started.elapsed();
+
+        let mut rng = rand::rng();
+        let mut tasks = tokio::task::JoinSet::new();
+        let mut outcomes = Vec::new();
+        let per_request = Arc::new(std::sync::Mutex::new(Vec::new()));
+        for i in 0..args.requests {
+            // Keep `concurrency` in flight.
+            while tasks.len() >= args.concurrency.max(1) {
+                outcomes.push(tasks.join_next().await.unwrap()?);
+            }
+            let body: Vec<u8> = {
+                let mut b = Vec::with_capacity(args.body);
+                while b.len() < args.body {
+                    b.extend_from_slice(format!("{{\"n\":{}}},", rng.random::<u32>()).as_bytes());
+                }
+                b.truncate(args.body);
+                b
+            };
+            // Every third request asks the server to close: the next one
+            // must open a new connection and re-handshake.
+            let template = if i % 3 == 2 { TEMPLATE_CLOSE } else { TEMPLATE };
+            let session = session.clone();
+            let per_request = per_request.clone();
+            tasks.spawn(async move {
+                let t = Instant::now();
+                let mut response = Vec::new();
+                let r = match session.request(template, body.clone(), &mut response, |_| {}).await {
+                    Ok(r) => r,
+                    Err(e) if e.downcast_ref::<lembas_mpc::session::Refused>().is_some() => {
+                        REFUSED.fetch_add(1, Ordering::Relaxed);
+                        // Try again: the pool lends from the (N+1)th request on.
+                        session.request(template, body.clone(), &mut response, |_| {}).await?
+                    }
+                    Err(e) => return Err(e),
+                };
+                per_request.lock().unwrap().push(t.elapsed());
+                let text = String::from_utf8_lossy(&response);
+                ensure!(
+                    text.starts_with("HTTP/1.1 200 OK"),
+                    "unexpected response: {}",
+                    &text[..text.len().min(200)]
+                );
+                let body_pos = text.find("\r\n\r\n").context("no header terminator")? + 4;
+                ensure!(dechunk(&response[body_pos..]) == body, "server did not echo the body");
+                Ok::<_, anyhow::Error>(r)
+            });
+        }
+        while let Some(outcome) = tasks.join_next().await {
+            outcomes.push(outcome?);
+        }
+        session.close().await;
+        let per_request = std::mem::take(&mut *per_request.lock().unwrap());
+        let responses = outcomes.into_iter().collect::<Result<Vec<_>>>()?;
+        Ok::<_, anyhow::Error>((responses, ready, per_request))
+    };
+    let outcome = tokio::try_join!(pool, borrower);
+    let total = started.elapsed();
+
+    if args.evil_rewrite || args.evil_server {
+        let err = match outcome {
+            Ok(_) => bail!("the borrower accepted a misbehaving pool"),
+            Err(err) => err,
+        };
+        let expected = if args.evil_rewrite { "alert" } else { "certificate" };
+        ensure!(
+            format!("{err:#}").to_ascii_lowercase().contains(expected),
+            "unexpected failure: {err:#}"
+        );
+        println!();
+        println!("misbehaving pool rejected as expected: {err:#}");
+        return Ok(());
+    }
+    let (stats, (responses, ready, per_request)) = outcome?;
+
+    drop(pool_link.session);
+    drop(borrower_link.session);
+    let _ = pool_link.close.send(());
+    let _ = borrower_link.close.send(());
+    pool_driver.await??;
+    borrower_driver.await??;
+
+    ensure!(responses.len() == args.requests);
+    ensure!(stats.requests as usize == args.requests, "pool counted {} requests", stats.requests);
+    let reused = responses.iter().filter(|r| r.reused).count();
+    let refused = REFUSED.load(Ordering::Relaxed);
+    ensure!(refused == args.refuse_first, "{refused} refusals seen, expected {}", args.refuse_first);
+    ensure!(stats.refused as usize == args.refuse_first, "pool counted {} refusals", stats.refused);
+
+    // What went over the link to the borrower must not contain the token.
+    let sent = SENT_TO_BORROWER.lock().unwrap();
+    ensure!(
+        !contains(&sent, TOKEN.as_bytes()),
+        "the token went to the borrower in the clear"
+    );
+    drop(sent);
+
+    let mut sorted = per_request.clone();
+    sorted.sort();
+    println!();
+    println!("borrowed requests OK");
+    println!("  protocol:              session of spliced records (zero-knowledge keystream)");
+    println!(
+        "  requests:              {} of {} bytes, {} at a time, all echoed back",
+        args.requests, args.body, args.concurrency
+    );
+    println!(
+        "  connections:           {} opened by the pool, {} requests reused one{}",
+        stats.connections,
+        reused,
+        if refused > 0 { format!(", {refused} refusals handled") } else { String::new() }
+    );
+    println!("  server identity:       verified by the borrower");
+    println!();
+    println!("timing (both parties on this machine)");
+    println!("  session ready (OT setup, once): {:>6.0?}", ready);
+    println!(
+        "  per request:           median {:>6.0?}, max {:>6.0?} (handshake included when a connection was opened)",
+        sorted[sorted.len() / 2],
+        sorted[sorted.len() - 1]
+    );
+    println!("  total:                 {:>8.0?}", total);
+    println!();
+    println!("pool↔borrower link");
+    let up = counters.received.load(Ordering::Relaxed);
+    let down = counters.sent.load(Ordering::Relaxed);
+    println!("  borrower → pool:       {:>8} KB ({} KB of it request bodies)", up / 1024, args.requests * args.body / 1024);
+    println!("  pool → borrower:       {:>8} KB (responses included)", down / 1024);
+
+    Ok(())
+}
+
+#[derive(Default, Clone)]
+struct LinkCounters {
+    /// Bytes the pool sent to the borrower.
+    sent: Arc<AtomicUsize>,
+    /// Bytes the pool received from the borrower.
+    received: Arc<AtomicUsize>,
+}
+
+/// Counts bytes and records everything the pool sends to the borrower, so the
+/// program can check the token is not among it.
+struct Counted {
+    inner: DuplexStream,
+    counters: LinkCounters,
+}
+
+impl Counted {
+    fn new(inner: DuplexStream, counters: LinkCounters) -> Self {
+        Self { inner, counters }
+    }
+}
+
+impl AsyncRead for Counted {
+    fn poll_read(
+        mut self: Pin<&mut Self>,
+        cx: &mut TaskContext<'_>,
+        buf: &mut ReadBuf<'_>,
+    ) -> Poll<std::io::Result<()>> {
+        let before = buf.filled().len();
+        let res = Pin::new(&mut self.inner).poll_read(cx, buf);
+        if let Poll::Ready(Ok(())) = &res {
+            let n = buf.filled().len() - before;
+            self.counters.received.fetch_add(n, Ordering::Relaxed);
+        }
+        res
+    }
+}
+
+impl AsyncWrite for Counted {
+    fn poll_write(
+        mut self: Pin<&mut Self>,
+        cx: &mut TaskContext<'_>,
+        data: &[u8],
+    ) -> Poll<std::io::Result<usize>> {
+        let res = Pin::new(&mut self.inner).poll_write(cx, data);
+        if let Poll::Ready(Ok(n)) = &res {
+            self.counters.sent.fetch_add(*n, Ordering::Relaxed);
+            SENT_TO_BORROWER
+                .lock()
+                .unwrap()
+                .extend_from_slice(&data[..*n]);
+        }
+        res
+    }
+
+    fn poll_flush(mut self: Pin<&mut Self>, cx: &mut TaskContext<'_>) -> Poll<std::io::Result<()>> {
+        Pin::new(&mut self.inner).poll_flush(cx)
+    }
+
+    fn poll_shutdown(mut self: Pin<&mut Self>, cx: &mut TaskContext<'_>) -> Poll<std::io::Result<()>> {
+        Pin::new(&mut self.inner).poll_shutdown(cx)
+    }
+}
+
+/// Everything the pool sent to the borrower, for the token check.
+static SENT_TO_BORROWER: std::sync::Mutex<Vec<u8>> = std::sync::Mutex::new(Vec::new());
+/// Refusals the borrower saw.
+static REFUSED: AtomicUsize = AtomicUsize::new(0);
+
+/// A token source that says no to the first `n` requests.
+fn refusing_first(n: usize, inner: lembas_mpc::session::TokenSource) -> lembas_mpc::session::TokenSource {
+    let count = Arc::new(AtomicUsize::new(0));
+    Arc::new(move || {
+        let inner = inner.clone();
+        let count = count.clone();
+        Box::pin(async move {
+            if count.fetch_add(1, Ordering::Relaxed) < n {
+                return Ok(None);
+            }
+            inner().await
+        })
+    })
+}
+
+fn contains(haystack: &[u8], needle: &[u8]) -> bool {
+    !needle.is_empty() && haystack.windows(needle.len()).any(|w| w == needle)
+}
diff --git a/crates/lembas-mpc/src/record.rs b/crates/lembas-mpc/src/record.rs
new file mode 100644
index 0000000..35bd527
--- /dev/null
+++ b/crates/lembas-mpc/src/record.rs
@@ -0,0 +1,224 @@
+//! TLS 1.2 AES-128-GCM records with keys this side holds: what the borrower
+//! runs after taking the keys out of rustls, continuing from the sequence
+//! numbers rustls reached (plus one on the client side, for the pool's
+//! record).
+
+use aes_gcm::{Aes128Gcm, NewAead, aead::AeadInPlace};
+use anyhow::{Result, bail, ensure};
+
+/// Largest plaintext a single TLS record may carry.
+pub const MAX_RECORD_PLAINTEXT: usize = 1 << 14;
+
+/// Record content types.
+pub const CHANGE_CIPHER_SPEC: u8 = 0x14;
+pub const ALERT: u8 = 0x15;
+pub const HANDSHAKE: u8 = 0x16;
+pub const APPLICATION_DATA: u8 = 0x17;
+
+/// The `close_notify` alert: warning level, description 0.
+pub const CLOSE_NOTIFY: [u8; 2] = [1, 0];
+
+const EXPLICIT_NONCE_LEN: usize = 8;
+const TAG_LEN: usize = 16;
+
+/// The TLS 1.2 traffic keys.
+#[derive(Clone)]
+pub struct TrafficKeys {
+    /// Client write key.
+    pub client_write_key: [u8; 16],
+    /// Client write IV (implicit nonce part).
+    pub client_write_iv: [u8; 4],
+    /// Server write key.
+    pub server_write_key: [u8; 16],
+    /// Server write IV (implicit nonce part).
+    pub server_write_iv: [u8; 4],
+}
+
+impl std::fmt::Debug for TrafficKeys {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("TrafficKeys").finish_non_exhaustive()
+    }
+}
+
+/// The additional data AES-GCM authenticates for a TLS 1.2 record.
+pub fn tls12_aad(seq: u64, typ: u8, len: usize) -> [u8; 13] {
+    let mut aad = [0u8; 13];
+    aad[..8].copy_from_slice(&seq.to_be_bytes());
+    aad[8] = typ;
+    aad[9] = 0x03;
+    aad[10] = 0x03;
+    aad[11..].copy_from_slice(&(len as u16).to_be_bytes());
+    aad
+}
+
+/// Both directions of the record layer.
+pub struct LocalRecordLayer {
+    keys: TrafficKeys,
+    writer: LocalRecordWriter,
+    reader: LocalRecordReader,
+}
+
+impl LocalRecordLayer {
+    /// Creates a record layer continuing from the given sequence numbers.
+    pub fn new(keys: &TrafficKeys, write_seq: u64, read_seq: u64) -> Self {
+        Self {
+            keys: keys.clone(),
+            writer: LocalRecordWriter::new(keys, write_seq),
+            reader: LocalRecordReader::new(keys, read_seq),
+        }
+    }
+
+    pub fn keys(&self) -> &TrafficKeys {
+        &self.keys
+    }
+
+    /// Encrypts one record and returns it encoded, ready for the wire.
+    pub fn encrypt(&mut self, typ: u8, plaintext: &[u8]) -> Result<Vec<u8>> {
+        self.writer.encrypt(typ, plaintext)
+    }
+
+    /// Decrypts one encoded record received from the server.
+    pub fn decrypt(&mut self, record: &[u8]) -> Result<(u8, Vec<u8>)> {
+        self.reader.decrypt(record)
+    }
+
+    /// Splits into the sending and the receiving half.
+    pub fn split(self) -> (LocalRecordWriter, LocalRecordReader) {
+        (self.writer, self.reader)
+    }
+}
+
+/// Encrypts records to the server under the client write key.
+pub struct LocalRecordWriter {
+    cipher: Aes128Gcm,
+    iv: [u8; 4],
+    seq: u64,
+}
+
+impl LocalRecordWriter {
+    fn new(keys: &TrafficKeys, seq: u64) -> Self {
+        Self {
+            cipher: Aes128Gcm::new((&keys.client_write_key).into()),
+            iv: keys.client_write_iv,
+            seq,
+        }
+    }
+
+    /// The next sequence number this writer will use.
+    pub fn seq(&self) -> u64 {
+        self.seq
+    }
+
+    /// Skips to a sequence number: the pool's token record took the one
+    /// before it.
+    pub fn set_seq(&mut self, seq: u64) {
+        self.seq = seq;
+    }
+
+    /// Encrypts one record and returns it encoded, ready for the wire. The
+    /// explicit nonce is the sequence number, as rustls does it.
+    pub fn encrypt(&mut self, typ: u8, plaintext: &[u8]) -> Result<Vec<u8>> {
+        ensure!(
+            plaintext.len() <= MAX_RECORD_PLAINTEXT,
+            "record plaintext too long: {} > {MAX_RECORD_PLAINTEXT}",
+            plaintext.len()
+        );
+        let seq = self.seq;
+        self.seq += 1;
+
+        let explicit_nonce = seq.to_be_bytes();
+        let mut nonce = [0u8; 12];
+        nonce[..4].copy_from_slice(&self.iv);
+        nonce[4..].copy_from_slice(&explicit_nonce);
+        let aad = tls12_aad(seq, typ, plaintext.len());
+
+        let mut body = plaintext.to_vec();
+        let tag = self
+            .cipher
+            .encrypt_in_place_detached((&nonce).into(), &aad, &mut body)
+            .map_err(|_| anyhow::anyhow!("encryption failed"))?;
+
+        let len = EXPLICIT_NONCE_LEN + body.len() + TAG_LEN;
+        let mut record = Vec::with_capacity(5 + len);
+        record.extend_from_slice(&[typ, 0x03, 0x03]);
+        record.extend_from_slice(&(len as u16).to_be_bytes());
+        record.extend_from_slice(&explicit_nonce);
+        record.extend_from_slice(&body);
+        record.extend_from_slice(&tag);
+        Ok(record)
+    }
+}
+
+/// Decrypts records from the server under the server write key.
+pub struct LocalRecordReader {
+    cipher: Aes128Gcm,
+    iv: [u8; 4],
+    seq: u64,
+}
+
+impl LocalRecordReader {
+    fn new(keys: &TrafficKeys, seq: u64) -> Self {
+        Self {
+            cipher: Aes128Gcm::new((&keys.server_write_key).into()),
+            iv: keys.server_write_iv,
+            seq,
+        }
+    }
+
+    /// Decrypts one whole encoded record (5-byte header included).
+    pub fn decrypt(&mut self, record: &[u8]) -> Result<(u8, Vec<u8>)> {
+        ensure!(record.len() >= 5, "record too short");
+        let typ = record[0];
+        ensure!(record[1] == 0x03, "not a TLS record");
+        let len = u16::from_be_bytes([record[3], record[4]]) as usize;
+        ensure!(record.len() == 5 + len, "record length mismatch");
+        let payload = &record[5..];
+        if payload.len() < EXPLICIT_NONCE_LEN + TAG_LEN {
+            bail!("ciphertext record is too short");
+        }
+        let (explicit_nonce, rest) = payload.split_at(EXPLICIT_NONCE_LEN);
+        let (ciphertext, tag) = rest.split_at(rest.len() - TAG_LEN);
+
+        let seq = self.seq;
+        self.seq += 1;
+
+        let mut nonce = [0u8; 12];
+        nonce[..4].copy_from_slice(&self.iv);
+        nonce[4..].copy_from_slice(explicit_nonce);
+        let aad = tls12_aad(seq, typ, ciphertext.len());
+
+        let mut plaintext = ciphertext.to_vec();
+        self.cipher
+            .decrypt_in_place_detached((&nonce).into(), &aad, &mut plaintext, tag.into())
+            .map_err(|_| anyhow::anyhow!("tag verification failed"))?;
+        Ok((typ, plaintext))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn round_trip_through_both_halves() {
+        let keys = TrafficKeys {
+            client_write_key: [1; 16],
+            client_write_iv: [2; 4],
+            server_write_key: [1; 16],
+            server_write_iv: [2; 4],
+        };
+        // The server's reader is the client's writer with the keys swapped,
+        // so with identical keys a writer at seq n decrypts with a reader at n.
+        let mut writer = LocalRecordLayer::new(&keys, 7, 0);
+        let mut reader = LocalRecordLayer::new(&keys, 0, 7);
+        let record = writer.encrypt(APPLICATION_DATA, b"hello").unwrap();
+        assert_eq!(record[0], APPLICATION_DATA);
+        assert_eq!(record.len(), 5 + 8 + 5 + 16);
+        assert_eq!(reader.decrypt(&record).unwrap(), (APPLICATION_DATA, b"hello".to_vec()));
+        // Wrong sequence number: the tag fails.
+        let record = writer.encrypt(ALERT, &CLOSE_NOTIFY).unwrap();
+        let mut skipped = LocalRecordLayer::new(&keys, 0, 9);
+        assert!(skipped.decrypt(&record).is_err());
+        assert_eq!(reader.decrypt(&record).unwrap(), (ALERT, CLOSE_NOTIFY.to_vec()));
+    }
+}
